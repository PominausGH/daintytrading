# Email provider — set ONE of these (Brevo preferred; Resend as fallback)
BREVO_API_KEY=xkeysib-your-brevo-api-key
RESEND_API_KEY=re_your_resend_api_key

# Verified sender address (must be verified in Brevo or Resend)
FROM_EMAIL=hello@daintytrading.com
FROM_NAME=Dainty Trading

# Where contact form submissions get emailed to
CONTACT_NOTIFICATION_EMAIL=hello@daintytrading.com

NODE_ENV=production

# Admin dashboard (single-user login at /admin/login.html)
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=generate-with-openssl-rand-hex-32
