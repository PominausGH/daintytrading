---
import BaseLayout from '../layouts/BaseLayout.astro';
import Price from '../components/Price.astro';
import Stat from '../components/Stat.astro';
import ClientShowcase from '../components/ClientShowcase.astro';
import { pricing, gstRegistered } from '../data/pricing.ts';

// Web-first homepage (Andrew, 2026-10-22): websites, Local SEO & GEO and Care lead; AI and
// software work lives on /services/software-ai.html. Every number here is a real, sourced stat:
// Shuttersmith visits (project-stats), the rebuild's Lighthouse scores, the Google rating.
const n = (v: number) => v.toLocaleString('en-AU');
const noGst = gstRegistered ? '' : ' No GST.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'TelaLoom',
    alternateName: 'TelaLoom Website Builds, Local SEO & GEO',
    url: 'https://telaloom.com',
    logo: 'https://telaloom.com/og-card.jpg',
    description: 'Australian web studio building websites for local and small businesses, with Local SEO and GEO built in so they are found on Google and in AI assistants. Also builds custom software and AI for clients who need it.',
    founder: { '@type': 'Person', '@id': 'https://telaloom.com/about.html#andrew-dainty', name: 'Andrew Dainty', url: 'https://telaloom.com/about.html#andrew-dainty', sameAs: ['https://www.linkedin.com/in/andrewdainty/'] },
    sameAs: [
      'https://www.linkedin.com/company/132014328/',
      'https://www.linkedin.com/in/andrewdainty/',
      'https://substack.com/@andrewdainty',
      'https://share.google/sPuFFHaeYpqb8IF9V',
    ],
    knowsAbout: [
      'Website design', 'Local SEO', 'Generative engine optimization', 'Google Business Profile',
      'Technical SEO', 'Structured data', 'Web performance', 'Custom software', 'AI automation',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'TelaLoom',
    url: 'https://telaloom.com',
    publisher: { '@type': 'Organization', name: 'TelaLoom' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'What is TelaLoom?', acceptedAnswer: { '@type': 'Answer', text: 'An Australian web studio. We build websites for local and small businesses, get them found on Google and in AI assistants with Local SEO and GEO, and look after them afterwards on the Care plan. We also build custom software and AI for clients who need it.' } },
      { '@type': 'Question', name: 'How much does a website cost?', acceptedAnswer: { '@type': 'Answer', text: `Three fixed prices, all one-off: a landing page is ${n(pricing.landingPage)} AUD, a Starter site of up to 5 pages is ${n(pricing.starterSite)} AUD, and a custom build is ${n(pricing.customBuild)} AUD with Local SEO and GEO setup included.${noGst} Logins, bookings and payments are quoted in writing first.` } },
      { '@type': 'Question', name: 'How long does a website take?', acceptedAnswer: { '@type': 'Answer', text: 'A first draft is live on a private preview link in weeks 1 to 2, with real pages and real copy, not a mockup. It goes live when you sign it off.' } },
      { '@type': 'Question', name: 'Do I own the website?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. It is set up on hosting in your name and you pay the host directly, the domain is registered in your own account, and once the build is paid you own the design and content made for you. No lock-in.' } },
      { '@type': 'Question', name: 'Can you fix the website I already have?', acceptedAnswer: { '@type': 'Answer', text: `Often that is all you need. Run the free website check first. Small fixes are ${n(pricing.fixDay)} AUD a day, and the SEO & GEO Setup at ${n(pricing.setupSingleTemplate)} AUD fixes the lot on your current site.` } },
      { '@type': 'Question', name: 'Do you build custom software or AI as well?', acceptedAnswer: { '@type': 'Answer', text: 'Yes: client portals, bookings and payments alongside a website, and AI product builds, automation and infrastructure for businesses that need them. See the Software & AI page.' } },
      { '@type': 'Question', name: 'Where are you based?', acceptedAnswer: { '@type': 'Answer', text: 'Australia. We work with clients in Australia and overseas, and invoice Australian clients in AUD and international clients in USD.' } },
      { '@type': 'Question', name: 'How do I start?', acceptedAnswer: { '@type': 'Answer', text: 'Send your business name and website (if you have one) through the contact page, or run the free website check. We reply within one business day with what we would do and what it costs.' } },
    ],
  },
];
---
<BaseLayout
  currencySwitch
  title="TelaLoom — Websites, Local SEO &amp; GEO for Small Businesses"
  description="Websites for local and small businesses that get found on Google and in AI answers. Published prices from a landing page to a custom build, hosted in your name, first draft in 1–2 weeks. Free website check."
  canonicalPath="/"
  ogImage="https://telaloom.com/og-card.jpg"
  jsonLd={jsonLd}
  hreflangAlternates={true}
>
  <style>
    .hero-split { padding: 88px 0 72px; text-align: left; }
    .hero-split .container { display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center; }
    .hero-split h1 { font-size: clamp(34px, 5vw, 56px); margin-top: 16px; }
    .hero-split p.lead { margin: 0 0 28px; max-width: 540px; }
    .hero-split .cta-row { justify-content: flex-start; }
    .hero-price { font-size: 14px; color: var(--text-muted); margin: 14px 0 0; }
    .browser { background: var(--bg-card); border: 1px solid var(--border-strong); border-radius: 12px; overflow: hidden; box-shadow: 0 30px 60px -20px rgba(124, 92, 255, 0.35), var(--shadow); }
    .browser-bar { display: flex; gap: 6px; padding: 10px 12px; border-bottom: 1px solid var(--border); }
    .browser-bar span { width: 10px; height: 10px; border-radius: 50%; background: var(--border-strong); }
    .browser img { display: block; width: 100%; height: auto; }
    .browser-cap { font-size: 12.5px; color: var(--text-muted); margin: 10px 0 0; text-align: center; }
    @media (max-width: 900px) {
      .hero-split .container { grid-template-columns: 1fr; gap: 36px; }
      .hero-split { padding: 56px 0 48px; }
    }

    .proof-band { background: linear-gradient(120deg, #5b3fe0 0%, #7c5cff 55%, #20b394 100%); padding: 34px 0; }
    .proof-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; text-align: center; color: #fff; }
    .proof-num { font-size: 30px; font-weight: 800; letter-spacing: -0.02em; }
    .proof-label { font-size: 13.5px; opacity: 0.9; margin-top: 2px; }
    @media (max-width: 720px) { .proof-grid { grid-template-columns: repeat(2, 1fr); } }

    .tier-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .tier { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 26px; display: flex; flex-direction: column; }
    .tier.featured { border-color: var(--accent); box-shadow: var(--shadow); }
    .tier .tier-name { font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); }
    .tier .tier-price { font-size: 30px; font-weight: 800; margin: 6px 0 8px; }
    .tier .tier-price small { font-size: 14px; font-weight: 500; color: var(--text-muted); white-space: nowrap; }
    .tier p { font-size: 14.5px; color: var(--text-dim); flex: 1; margin: 0 0 16px; }
    .tier a { font-weight: 600; }
    .tier-foot { text-align: center; color: var(--text-dim); font-size: 14.5px; margin: 26px 0 0; }
    @media (max-width: 900px) { .tier-grid { grid-template-columns: 1fr; } }

    .light-band { background: #f4f2ff; color: #161a24; }
    .light-band h2 { color: #161a24; }
    .light-band .testimonial-card { background: #fff; border-color: #e2ddff; }
    .light-band .testimonial-quote { color: #262b38; }
    .light-band .testimonial-caption, .light-band .testimonial-caption a { color: #535b6e; }
    .light-band .testimonial-name { color: #161a24; }
    .light-band .gbp-card { background: #fff; border-color: #e2ddff; color: #161a24; }
    .light-band .gbp-label { color: #535b6e; }

    .also-row { display: flex; flex-wrap: wrap; gap: 18px; align-items: center; justify-content: space-between; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px 28px; }
    .also-row p { margin: 0; color: var(--text-dim); max-width: 680px; }
    .also-row strong { color: var(--text); }
    #client-work .project-grid { grid-template-columns: repeat(2, 1fr); }
    @media (max-width: 720px) { #client-work .project-grid { grid-template-columns: 1fr; } }
    .industries { text-align: center; color: var(--text-dim); margin: 28px 0 0; font-size: 15px; }
  </style>

  <main id="main">
    <section class="hero hero-split">
      <div class="container">
        <div>
          <span class="eyebrow">Websites &middot; Local SEO &amp; GEO</span>
          <h1>Websites that get local businesses found.</h1>
          <p class="lead">On Google, on the map, and when customers ask ChatGPT who to call. Built around your business, set up in your name, with a first draft to click through in 1&ndash;2 weeks.</p>
          <div class="cta-row">
            <a class="btn btn-primary" href="/contact.html" data-umami-event="cta_click" data-umami-event-target="get_a_quote" data-umami-event-source="index_hero">Get a quote &rarr;</a>
            <a class="btn btn-ghost" href="/site-check.html" data-umami-event="cta_click" data-umami-event-target="free_audit" data-umami-event-source="index_hero">Free website check</a>
          </div>
          <p class="hero-price">Published prices from <Price item="landingPage" symbol />.{gstRegistered ? '' : ' No GST,'} {gstRegistered ? 'No' : 'no'} lock-in.</p>
        </div>
        <figure style="margin:0;">
          <div class="browser">
            <div class="browser-bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <picture>
              <source srcset="/screenshots/clients/shuttersmith-rebuild-home.webp" type="image/webp" />
              <img src="/screenshots/clients/shuttersmith-rebuild-home.png" width="1280" height="800" alt="Shuttersmith website rebuild homepage: Custom Blinds Gold Coast, with quote and call buttons" loading="eager" decoding="async" fetchpriority="high" />
            </picture>
          </div>
          <figcaption class="browser-cap">Our rebuild for Shuttersmith, Gold Coast shutters &amp; blinds (in preview)</figcaption>
        </figure>
      </div>
    </section>

    <div class="proof-band">
      <div class="container">
        <div class="proof-grid">
          <div><div class="proof-num"><Stat k="shuttersmith.visits" /></div><div class="proof-label">visits to Shuttersmith since we fixed its site in July</div></div>
          <div><div class="proof-num">100</div><div class="proof-label">Lighthouse SEO score on the Shuttersmith rebuild</div></div>
          <div><div class="proof-num">5.0&#9733;</div><div class="proof-label">rating on Google</div></div>
          <div><div class="proof-num">1&ndash;2 wks</div><div class="proof-label">to a first draft you can click through</div></div>
        </div>
      </div>
    </div>

    <ClientShowcase source="index_showcase" />

    <section id="client-work">
      <div class="container">
        <div class="section-head">
          <h2>Client work</h2>
          <p>Real businesses, with the before and after on each project page.</p>
        </div>
        <div class="project-grid">
          <a class="project-card" href="/projects/edwards-kirby-lawyers.html">
            <span class="tag">Client · Legal</span>
            <h3>Sydney Insolvency Law Firm</h3>
            <p>Full website rebuild for a Sydney insolvency and business law firm, plus a secure client portal with MFA and encrypted document storage, and SEO/GEO built in from day one.</p>
            <span class="outcome-line">About to go live</span>
            <span class="arrow">Read the story →</span>
          </a>
          <a class="project-card" href="/projects/shuttersmith.html">
            <span class="tag">Client · SEO/GEO</span>
            <h3>Shuttersmith</h3>
            <p>A Gold Coast shutters business with no analytics, no schema and AI crawlers blocked at the host. We fixed all of it on the existing site first.</p>
            <span class="outcome-line"><Stat k="shuttersmith.visits" /> real visits, majority via Google &middot; led to a second business</span>
            <span class="arrow">Read the story →</span>
          </a>
          <a class="project-card" href="/projects/shuttersmith-rebuild.html">
            <span class="tag">Client · Website build</span>
            <h3>Shuttersmith Rebuild</h3>
            <p>Off WordPress and Elementor onto a fast static build, with 7 pages, 10 blog posts and 10 suburb pages carried over.</p>
            <span class="outcome-line">Perf 92&ndash;98 &middot; Accessibility/Best Practices/SEO 100 &middot; awaiting sign-off</span>
            <span class="arrow">Read the story →</span>
          </a>
          <a class="project-card" href="/projects/new-shutter-business.html">
            <span class="tag">Client · Home improvement</span>
            <h3>New Shutter Business</h3>
            <p>A second business the same owner launched off Shuttersmith&rsquo;s results: trade-price shutters with a self-install option and a measure-and-quote calculator.</p>
            <span class="outcome-line">In staging, launching soon</span>
            <span class="arrow">Read the story →</span>
          </a>
        </div>
        <p class="industries">Built for your industry before? See <a href="/industries/law-firms.html">law firm websites</a> and <a href="/industries/shutters-blinds.html">shutter &amp; blind websites</a>.</p>
      </div>
    </section>

    <section class="for-you">
      <div class="container">
        <p class="for-you-label">This is for you if&hellip;</p>
        <div class="for-you-grid">
          <div class="for-you-card">
            <span class="for-you-check">&#10003;</span>
            <div>
              <strong>You don&rsquo;t have a proper website yet</strong>
              <p>A new business, a new service, or a site someone threw together years ago. You need something that looks right and brings in enquiries.</p>
            </div>
          </div>
          <div class="for-you-card">
            <span class="for-you-check">&#10003;</span>
            <div>
              <strong>Your site isn&rsquo;t being found</strong>
              <p>It looks fine, but Google and AI assistants like ChatGPT aren&rsquo;t sending you customers, and you want the fix done in the site, not handed over as a PDF.</p>
            </div>
          </div>
          <div class="for-you-card">
            <span class="for-you-check">&#10003;</span>
            <div>
              <strong>You need more than pages</strong>
              <p>Quotes, bookings, payments or a secure client portal, built alongside the website and quoted in writing before we start.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="prices">
      <div class="container">
        <div class="section-head">
          <h2>Published prices</h2>
          <p>One-off and fixed{gstRegistered ? '' : ', no GST'}: the price on the page is the price you pay.</p>
        </div>
        <div class="tier-grid">
          <div class="tier">
            <span class="tier-name">Landing page</span>
            <div class="tier-price"><Price item="landingPage" /> <small>one-off</small></div>
            <p>One page that turns visitors into enquiries, copy written for you, set up to be found locally. Credited in full if you move up within 6 months.</p>
            <a href="/services/website-builds.html#packages" data-umami-event="cta_click" data-umami-event-target="see_packages" data-umami-event-source="index_tier_landing">What&rsquo;s included &rarr;</a>
          </div>
          <div class="tier">
            <span class="tier-name">Starter site</span>
            <div class="tier-price"><Price item="starterSite" /> <small>one-off</small></div>
            <p>Up to 5 pages on proven layouts, styled to your brand, with copy, Google Business Profile setup and AI search bots let in.</p>
            <a href="/services/website-builds.html#packages" data-umami-event="cta_click" data-umami-event-target="see_packages" data-umami-event-source="index_tier_starter">What&rsquo;s included &rarr;</a>
          </div>
          <div class="tier featured">
            <span class="tier-name">Custom build</span>
            <div class="tier-price"><Price item="customBuild" /> <small>one-off</small></div>
            <p>Designed from scratch around your business, with suburb and service pages and the full Local SEO &amp; GEO setup included.</p>
            <a href="/services/website-builds.html#packages" data-umami-event="cta_click" data-umami-event-target="see_packages" data-umami-event-source="index_tier_custom">What&rsquo;s included &rarr;</a>
          </div>
        </div>
        <p class="tier-foot">Already have a site? The <a href="/site-check.html">free website check</a> shows what&rsquo;s worth fixing, and the <a href="/services/local-seo.html">Local SEO &amp; GEO Setup</a> is <Price item="setupSingleTemplate" symbol />. Afterwards, the <a href="/services/website-builds.html#packages">Care plan</a> keeps it updated for <Price item="carePlan" symbol suffix="/mo" />.</p>
      </div>
    </section>

    <section id="why">
      <div class="container">
        <div class="section-head">
          <h2>Why TelaLoom</h2>
          <p>Most agencies spend weeks on a proposal. We spend them building.</p>
        </div>
        <div class="service-grid service-grid-2col">
          <div class="service-card">
            <div class="icon">01</div>
            <h3>Real client sites, not a pitch deck</h3>
            <p>Every website and SEO/GEO engagement gets its own project page with the real before and after, the actual traffic numbers, and what broke along the way.</p>
          </div>
          <div class="service-card">
            <div class="icon">02</div>
            <h3>A working draft in 1&ndash;2 weeks</h3>
            <p>Real pages with real copy on a private preview link you can open on your phone. Not a design file, and no long discovery phase before anything exists.</p>
          </div>
          <div class="service-card">
            <div class="icon">03</div>
            <h3>Found on Google and in AI answers</h3>
            <p>Google Business Profile, local schema, the site submitted to Google and Bing, and AI search bots let in, done as part of the build rather than sold to you afterwards.</p>
          </div>
          <div class="service-card">
            <div class="icon">04</div>
            <h3>Yours, with no lock-in</h3>
            <p>Hosting and domain in your name, published prices, and a Care plan you can cancel any month. <a href="/services/website-builds.html#questions-to-ask">Questions to ask any web designer</a>, with our answers.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="how-it-works">
      <div class="container">
        <div class="section-head">
          <h2>How a build works</h2>
          <p>From first message to a site you can click through, in about two weeks.</p>
        </div>
        <div class="flow-grid">
          <div class="flow-step">
            <div class="flow-num">Day 1</div>
            <h3>Tell us about the business</h3>
            <p>Your business name and Google listing are enough. We reply within one business day with an honest read, including whether a fix would do instead.</p>
          </div>
          <div class="flow-step">
            <div class="flow-num">Week 1</div>
            <h3>Scope and price, in writing</h3>
            <p>The published price for the build you need. Anything extra, like bookings or a portal, is estimated and approved by you before we start.</p>
          </div>
          <div class="flow-step">
            <div class="flow-num">Weeks 1&ndash;2</div>
            <h3>First draft on a preview link</h3>
            <p>You review it, we make the changes, and it goes live on your own hosting when you sign it off.</p>
          </div>
        </div>
        <p class="center mt-36"><a class="btn btn-primary" href="/contact.html" data-umami-event="cta_click" data-umami-event-target="get_a_quote" data-umami-event-source="index_process">Get a quote &rarr;</a></p>
      </div>
    </section>

    <section class="testimonials-section light-band">
      <div class="container">
        <h2 class="testimonials-title">What clients say</h2>
        <div class="testimonials-narrow testimonials-narrow--spaced">
          <a href="https://www.google.com/maps/place/?q=place_id:ChIJ2VLpW3U4aoQRz6YI6UQ2hr4" target="_blank" rel="noopener" class="gbp-card">
            <img src="/gbp-logo.png" width="40" height="40" alt="" loading="lazy" class="gbp-logo" />
            <div>
              <div class="gbp-rating-row">
                <span class="gbp-score">5.0</span>
                <span class="gbp-stars">★★★★★</span>
              </div>
              <div class="gbp-label">Rated on Google &rarr;</div>
            </div>
          </a>
        </div>
        <div class="testimonials-narrow">
          <figure class="testimonial-card">
            <blockquote class="testimonial-quote">&ldquo;We engaged Andrew to have a look at our website,he explained what he needed to do and fixed everything and we our now getting lots more jobs through from.the internet traffic He also built a new website for a new branch of the business The work is fantastic and he absolutely nalied it Its about time we spent some money and got the return you hope for After several companies I have found the one I will be sticking with&rdquo;</blockquote>
            <figcaption class="testimonial-caption">
              <span class="testimonial-stars">★★★★★</span>&nbsp;
              <strong class="testimonial-name">Craig Smith</strong> &middot; Local Guide &middot; <a href="https://www.google.com/maps/place/?q=place_id:ChIJ2VLpW3U4aoQRz6YI6UQ2hr4" target="_blank" rel="noopener" class="link-dim">Google review</a> &middot; <a href="/projects/new-shutter-business.html" class="link-dim">read the case study</a>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="software">
      <div class="container">
        <div class="also-row">
          <p><strong>Need software, not just a website?</strong> We also build client portals, bookings and payments, AI features and automation, on the same stack we run for our own products.</p>
          <a class="btn btn-ghost" href="/services/software-ai.html" data-umami-event="cta_click" data-umami-event-target="software_ai" data-umami-event-source="index_also_row">Software &amp; AI &rarr;</a>
        </div>
      </div>
    </section>

    <section id="faq">
      <div class="container">
        <div class="section-head">
          <h2>Frequently asked questions</h2>
          <p>Short answers to what people ask before getting a quote.</p>
        </div>
        <div class="faq-list">
          <details class="faq-item" open>
            <summary>What is TelaLoom?</summary>
            <p>An Australian web studio. We build websites for local and small businesses, get them found on Google and in AI assistants with Local SEO &amp; GEO, and look after them afterwards on the Care plan. We also build <a href="/services/software-ai.html">custom software and AI</a> for clients who need it.</p>
          </details>
          <details class="faq-item">
            <summary>How much does a website cost?</summary>
            <p>Three fixed prices, all one-off: a landing page is <Price item="landingPage" symbol />, a Starter site of up to 5 pages is <Price item="starterSite" symbol />, and a custom build is <Price item="customBuild" symbol /> with Local SEO &amp; GEO setup included.{noGst} Logins, bookings and payments are quoted in writing first. <a href="/pricing.html">All prices</a>.</p>
          </details>
          <details class="faq-item">
            <summary>How long does a website take?</summary>
            <p>A first draft is live on a private preview link in weeks 1&ndash;2, with real pages and real copy, not a mockup. It goes live when you sign it off.</p>
          </details>
          <details class="faq-item">
            <summary>Do I own the website?</summary>
            <p>Yes. It&rsquo;s set up on hosting in your name and you pay the host directly, the domain is registered in your own account, and once the build is paid you own the design and content made for you. No lock-in.</p>
          </details>
          <details class="faq-item">
            <summary>Can you fix the website I already have?</summary>
            <p>Often that&rsquo;s all you need. Run the <a href="/site-check.html">free website check</a> first. Small fixes are <Price item="fixDay" symbol /> a day, and the SEO &amp; GEO Setup at <Price item="setupSingleTemplate" symbol /> fixes the lot on your current site.</p>
          </details>
          <details class="faq-item">
            <summary>Do you build custom software or AI as well?</summary>
            <p>Yes: client portals, bookings and payments alongside a website, and AI product builds, automation and infrastructure for businesses that need them. See <a href="/services/software-ai.html">Software &amp; AI</a>.</p>
          </details>
          <details class="faq-item">
            <summary>Where are you based?</summary>
            <p>Australia. We work with clients in Australia and overseas, and invoice Australian clients in AUD and international clients in USD.</p>
          </details>
          <details class="faq-item">
