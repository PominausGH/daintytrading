---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Price from '../../components/Price.astro';
import CurrencySwitch from '../../components/CurrencySwitch.astro';
import QuickEnquiry from '../../components/QuickEnquiry.astro';
import ClientShowcase from '../../components/ClientShowcase.astro';
import { pricing, pricingUsd } from '../../data/pricing.ts';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Website Builds for Local Businesses',
    provider: { '@type': 'Organization', name: 'TelaLoom', url: 'https://telaloom.com' },
    serviceType: 'Website design and development',
    description: 'Custom-built websites for local businesses, with Local SEO and GEO included from day one, set up on hosting in the client’s own name.',
    areaServed: 'Worldwide',
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Website build packages',
      itemListElement: [
        { '@type': 'Offer', name: 'Custom build', price: String(pricing.customBuild), priceCurrency: 'AUD', description: `One-off. Custom-designed site, copywriting, set up on hosting in your name, SSL, and Local SEO & GEO setup included — not sold separately.` },
        { '@type': 'Offer', name: 'Care plan', price: String(pricing.carePlan), priceCurrency: 'AUD', description: 'Monthly, no GST. Uptime monitoring and security updates on your own hosting, and up to 60 minutes of small content changes per month (unused time does not roll over, billed at the standard hourly rate beyond that). 2-business-day response time, same-day for security or downtime issues. Attached to every custom build by default. Cancel anytime, effective end of the current billing month.' },
        { '@type': 'Offer', name: 'Monitor', price: String(pricing.monitor), priceCurrency: 'AUD', description: 'Monthly. Automated ranking and AI-citation monitoring, with a monthly plain-English report. No fix pass included. Cancel anytime.' },
        { '@type': 'Offer', name: 'Growth', price: String(pricing.growth), priceCurrency: 'AUD', description: 'Monthly. Everything in Monitor, plus Google Business Profile posts, review replies, and a review campaign each month. Cancel anytime.' },
        { '@type': 'Offer', name: 'Scale', price: String(pricing.scale), priceCurrency: 'AUD', description: 'Monthly. Everything in Growth, plus new suburb/service pages, full Google Business Profile management, monthly content, and a quarterly strategy call.' },
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Is Local SEO really included in the Custom build price, or is that extra?', acceptedAnswer: { '@type': 'Answer', text: "It's included in the Custom build price — Google Business Profile setup, LocalBusiness schema, llms.txt and AI-crawler access, and a review-generation system, the same scope as our standalone Local SEO & GEO service. You're not paying for the site and then paying again to make it findable." } },
      { '@type': 'Question', name: 'What if I need customer accounts, bookings, or a database?', acceptedAnswer: { '@type': 'Answer', text: `We build those. It's the same work as a website with more moving parts, and the size varies a lot: a simple booking form is a small job, a customer portal is a big one. That's why a fixed website price can't honestly cover it. Tell us what it needs to do, and we'll estimate the days up front and give you the price in writing. You approve it before we start. Bigger work is priced from ${pricing.fixDay.toLocaleString()} AUD (${pricingUsd.fixDay.toLocaleString()} USD) per day of work.` } },
      { '@type': 'Question', name: 'Who owns the domain — us or you?', acceptedAnswer: { '@type': 'Answer', text: "You. If you already have a domain, we connect it. If you don't, our default is to register it directly in your own registrar account so there's never a custody question — no lock-in, nothing to transfer later. If you'd rather we register it first for speed, we hand it over via a standard domain transfer whenever you want it, using the authorization code your registrar provides. Either way, the first year's registration is included in the build price; renewal after that is yours." } },
    ],
  },
];
---
<BaseLayout
  currencySwitch
  title="Website Builds for Local Businesses — Custom Sites with Local SEO Built In | TelaLoom"
  description="Custom websites for local businesses, designed and written around your business, with Local SEO &amp; GEO included for $6,900 AUD. Hosting in your name, no lock-in."
  canonicalPath="/services/website-builds.html"
  jsonLd={jsonLd}
>
  <style>
    .price-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin:10px 0; }
    .price-grid--two { grid-template-columns:repeat(2,1fr); }
    @media (max-width:980px) { .price-grid, .price-grid--two { grid-template-columns:1fr; } }
    .price-card { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:24px; display:flex; flex-direction:column; }
    .price-card.featured { border-color:var(--accent); box-shadow:var(--shadow); }
    .price-card .tier { font-size:13px; letter-spacing:.04em; text-transform:uppercase; color:var(--text-muted); }
    .price-card .price { font-size:30px; font-weight:700; margin:6px 0 2px; color:var(--text); }
    .price-card .price small { font-size:14px; font-weight:500; color:var(--text-muted); }
    .price-card .note { font-size:12.5px; color:var(--text-muted); margin:0 0 14px; }
    .price-card ul { list-style:none; padding:0; margin:6px 0 18px; flex:1; }
    .price-card li { font-size:14px; color:var(--text-dim); padding:7px 0 7px 22px; position:relative; border-top:1px solid var(--border); }
    .price-card li:first-child { border-top:none; }
    .price-card li::before { content:"\2713"; position:absolute; left:0; color:var(--accent); font-weight:700; }
    .price-card .btn { width:100%; text-align:center; }
    .price-badge { display:inline-block; font-size:11px; text-transform:uppercase; letter-spacing:.05em; background:var(--accent-soft); color:var(--accent); padding:3px 9px; border-radius:999px; margin-bottom:10px; }
    .month-list { list-style:none; padding:0; margin:6px 0 0; }
    .month-list li { font-size:13.5px; color:var(--text-dim); padding:5px 0 5px 20px; position:relative; border:none; }
    .month-list li::before { content:"\2192"; position:absolute; left:0; color:var(--text-muted); font-weight:400; }
    .honest-note { background:var(--accent-soft); border:1px solid var(--border); border-radius:var(--radius-sm); padding:14px 16px; font-size:14px; color:var(--text-dim); margin:22px 0; }
    .honest-note strong { color:var(--text); }
    #packages, #process, #enquire { scroll-margin-top:88px; }
    .hero-actions { display:flex; flex-wrap:wrap; align-items:center; gap:12px 20px; margin-top:28px; }
    .hero-actions .cta-row { justify-content:flex-start; }
    .hero-rating { display:inline-flex; align-items:center; gap:10px; text-decoration:none; padding:6px 14px 6px 6px; border:1px solid var(--border); border-radius:999px; background:var(--bg-card); }
    .hero-rating img { border-radius:6px; }
    .hero-rating .gbp-score { font-size:18px; }
    .hero-rating .gbp-stars { font-size:14px; }
    .hero-rating .gbp-label { font-size:11px; }
    .build-steps { list-style:none; padding:0; margin:18px 0 8px; counter-reset:step; }
    .build-steps li { position:relative; padding:0 0 22px 56px; margin:0; }
    .build-steps li::before { counter-increment:step; content:counter(step); position:absolute; left:0; top:0; width:36px; height:36px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:15px; background:var(--accent-soft); color:var(--accent-text); border:1px solid var(--border); }
    .build-steps li::after { content:""; position:absolute; left:18px; top:40px; bottom:4px; width:1px; background:var(--border); }
    .build-steps li:last-child::after { display:none; }
    .build-steps .when { display:block; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--accent-text); margin-bottom:2px; }
    .build-steps h3 { font-size:17px; margin:0 0 6px; }
    .build-steps p { font-size:14.5px; color:var(--text-dim); margin:0; }
  </style>

  <main id="main">
    <section class="detail-hero">
      <div class="container">
        <div class="crumbs"><a href="/">Home</a> &nbsp;/&nbsp; <a href="/services.html">Services</a> &nbsp;/&nbsp; Website builds</div>
        <h1>Custom Websites for Local Businesses, with Local SEO Built In</h1>
        <p class="lede">A real site designed and written around your business, with Local SEO &amp; GEO switched on from day one, not sold to you later as a separate line item.</p>
        <div class="hero-actions">
          <div class="cta-row">
            <a class="btn btn-primary" href="#enquire" data-umami-event="cta_click" data-umami-event-target="get_a_quote" data-umami-event-source="website_builds_hero">Get a quote &rarr;</a>
            <a class="btn btn-ghost" href="#packages" data-umami-event="cta_click" data-umami-event-target="see_packages" data-umami-event-source="website_builds_hero">See packages &amp; prices</a>
          </div>
          <a class="hero-rating" href="https://www.google.com/maps/place/?q=place_id:ChIJ2VLpW3U4aoQRz6YI6UQ2hr4" target="_blank" rel="noopener" data-umami-event="cta_click" data-umami-event-target="google_reviews" data-umami-event-source="website_builds_hero">
            <img src="/gbp-logo.png" width="28" height="28" alt="" />
            <span class="gbp-score">5.0</span>
            <span class="gbp-stars">★★★★★</span>
            <span class="gbp-label">Rated on Google</span>
          </a>
        </div>
      </div>
    </section>

    <ClientShowcase source="website_builds_showcase" />

    <div class="container">
      <div class="detail-body">
        <article class="prose">
          <h2>Who this is for</h2>
          <p>Local businesses with no website at all, or one that's old, DIY, and doing them no favours &mdash; tradies, clinics, home services, anyone whose customers are local and searching for them right now. If that's you, this is a site built properly around your business, and set up to be found.</p>

          <h2 id="packages">Packages</h2>
          <CurrencySwitch />
          <div class="price-grid price-grid--two">
            <div class="price-card featured">
              <span class="price-badge">Most popular</span>
              <span class="tier">Custom build</span>
              <div class="price"><Price item="customBuild" /> <small>one-off</small></div>
              <p class="note">Designed and written around your business, no lock-in.</p>
              <ul>
                <li>Custom design and copywriting &mdash; not a template</li>
                <li>Set up on hosting in your name (you pay the host directly), SSL, and your domain &mdash; connected if you already have one, or registered in your name if you don&rsquo;t (first year included)</li>
                <li>Local SEO &amp; GEO setup included, not sold separately</li>
                <li>LocalBusiness schema, service-area pages, llms.txt</li>
                <li>A system to turn happy customers into reviews</li>
              </ul>
              <a class="btn btn-primary" href="/contact.html" data-umami-event="cta_click" data-umami-event-target="get_a_quote" data-umami-event-source="website_builds_custom_build">Get a quote &rarr;</a>
            </div>

            <div class="price-card">
              <span class="tier">Care plan <small style="text-transform:none;letter-spacing:0;">&mdash; monthly</small></span>
              <div class="price"><Price item="carePlan" /><small>/mo, no GST</small></div>
              <p class="note">Attached to every custom build by default &mdash; opt out if you&rsquo;d rather self-manage. Cancel anytime, effective end of the current billing month.</p>
              <ul class="month-list">
                <li>Uptime and SSL monitoring on your own hosting</li>
                <li>Software and security updates</li>
                <li>Up to 60 minutes/month of small changes &mdash; text edits, photo swaps, a new testimonial (unused time doesn&rsquo;t roll over; extra work billed at our standard hourly rate)</li>
                <li>2-business-day response time &mdash; same-day for security or downtime issues</li>
              </ul>
              <a class="btn btn-ghost" href="/contact.html" style="margin-top:16px;" data-umami-event="cta_click" data-umami-event-target="talk_it_through" data-umami-event-source="website_builds_care_plan">Talk it through &rarr;</a>
            </div>
          </div>

          <h3 style="margin-top:28px;">Then, optional Local SEO &amp; GEO plans</h3>
          <p style="font-size:14px;color:var(--text-dim);margin:0 0 16px;">Same product as our <a href="/services/local-seo.html">standalone Local SEO &amp; GEO service</a> &mdash; three tiers, cancel anytime.</p>
          <div class="price-grid">
            <div class="price-card">
              <span class="tier">Monitor <small style="text-transform:none;letter-spacing:0;">&mdash; monthly</small></span>
              <div class="price"><Price item="monitor" /><small>/mo</small></div>
              <p class="note">Watch it, report on it, no fix pass included.</p>
              <ul class="month-list">
                <li>Automated ranking &amp; AI-citation monitoring</li>
                <li>A plain-English report: searches, visitors, calls</li>
              </ul>
              <a class="btn btn-ghost" href="/contact.html" style="margin-top:16px;" data-umami-event="cta_click" data-umami-event-target="talk_it_through" data-umami-event-source="website_builds_monitor">Talk it through &rarr;</a>
            </div>

            <div class="price-card featured">
              <span class="price-badge">Most popular</span>
              <span class="tier">Growth <small style="text-transform:none;letter-spacing:0;">&mdash; monthly</small></span>
              <div class="price"><Price item="growth" /><small>/mo</small></div>
              <p class="note">Monitor, plus we keep working your listing.</p>
              <ul class="month-list">
                <li>Google Business Profile posts &amp; review replies</li>
                <li>A review campaign to that month&rsquo;s customers</li>
              </ul>
              <a class="btn btn-primary" href="/contact.html" style="margin-top:16px;" data-umami-event="cta_click" data-umami-event-target="talk_it_through" data-umami-event-source="website_builds_growth">Talk it through &rarr;</a>
            </div>

            <div class="price-card">
              <span class="tier">Scale <small style="text-transform:none;letter-spacing:0;">&mdash; monthly</small></span>
              <div class="price"><Price item="scale" /><small>/mo</small></div>
              <p class="note">For businesses actively expanding into new areas.</p>
              <ul class="month-list">
                <li>New suburb/service pages each month</li>
                <li>Full Google Business Profile management</li>
                <li>A quarterly strategy call</li>
              </ul>
              <a class="btn btn-ghost" href="/contact.html" style="margin-top:16px;" data-umami-event="cta_click" data-umami-event-target="talk_it_through" data-umami-event-source="website_builds_scale">Talk it through &rarr;</a>
            </div>
          </div>

          <div class="honest-note">
            <strong>Not sure you need a new site?</strong> If you already have one, start with a <a href="/site-check.html">free SEO/GEO audit</a> &mdash; it tells you whether it needs a rebuild or just fixing, at no cost. We'll tell you plainly if you're paying for more than you need.
          </div>

          <h2 id="process">How a custom build works</h2>
          <p>Same shape every time, so you always know what happens next and what it costs.</p>
          <ol class="build-steps">
            <li>
              <span class="when">Day 1</span>
              <h3>You tell us about the business</h3>
              <p>Use the form at the bottom of this page, or just send your business name and Google listing. We reply within one business day with our honest read, including whether a fix to your current site would do the job instead.</p>
            </li>
            <li>
              <span class="when">Week 1</span>
              <h3>Scope and price, in writing</h3>
              <p>If you already have a site, the <a href="/site-check.html">free website check</a> shows what&rsquo;s worth keeping. The custom build is the published price above. Anything beyond it, like logins or bookings, is estimated in days and approved by you before we start.</p>
            </li>
            <li>
              <span class="when">Weeks 1&ndash;2</span>
              <h3>First draft live on a preview link</h3>
              <p>Real pages with real copy, running on a private preview address you can open on your phone. Not a mockup or a design file.</p>
            </li>
            <li>
              <span class="when">Your review</span>
              <h3>Changes until you sign off</h3>
              <p>You tell us what&rsquo;s wrong and we fix it on the same preview link. Nothing goes live without your OK.</p>
            </li>
            <li>
              <span class="when">Launch</span>
              <h3>Live, and set up to be found</h3>
              <p>Your domain connected (or registered in your name), SSL, Google Business Profile, LocalBusiness schema, llms.txt, and the review system switched on.</p>
            </li>
            <li>
              <span class="when">After launch</span>
              <h3>Looked after</h3>
              <p>The Care plan keeps it updated and monitored on your hosting, with small changes each month. Add a Local SEO &amp; GEO plan if you want us to keep working on rankings.</p>
            </li>
          </ol>

          <h2>Why us</h2>
          <p><strong>No lock-in, on either tier.</strong> You own the domain, and nothing here traps you on a platform you can't leave &mdash; unlike a DIY builder, where walking away means starting from scratch.</p>
          <p><strong>SEO/GEO built in, not bolted on later.</strong> The custom build includes the same Local SEO &amp; GEO scope as our standalone service, so you're not found nowhere for months while you save up for a second project.</p>
          <p><strong>We tell you when you don't need a rebuild.</strong> If a fix day or the free website check is all your site needs, we'd rather say that than upsell you.</p>

          <h2>What this is not</h2>
          <p>Customer logins, a booking system, payments, or anything else with real application logic behind it isn't in the fixed-price tiers above &mdash; but it's not off the table. We built exactly that for <a href="/projects/edwards-kirby-lawyers.html">a Sydney insolvency law firm</a>: a secure client portal with logins, role-based access, and encrypted document storage, built alongside their website rebuild. Tell us what you need and we'll estimate the days up front, give you the price in writing, and you approve it before we start. Bigger work is priced from <Price item="fixDay" /> per day of work, so the price follows the size of the job.</p>

          <h2>What a client says</h2>
          <figure class="testimonial-card">
            <blockquote class="testimonial-quote">&ldquo;We engaged Andrew to have a look at our website,he explained what he needed to do and fixed everything and we our now getting lots more jobs through from.the internet traffic He also built a new website for a new branch of the business The work is fantastic and he absolutely nalied it Its about time we spent some money and got the return you hope for After several companies I have found the one I will be sticking with&rdquo;</blockquote>
            <figcaption class="testimonial-caption">
              <span class="testimonial-stars">★★★★★</span>&nbsp;
              <strong class="testimonial-name">Craig Smith</strong> &middot; Local Guide &middot; <a href="https://www.google.com/maps/place/?q=place_id:ChIJ2VLpW3U4aoQRz6YI6UQ2hr4" target="_blank" rel="noopener" class="link-dim">Google review</a> &middot; <a href="/projects/new-shutter-business.html" class="link-dim">read the case study</a>
            </figcaption>
          </figure>

          <h2>Frequently asked questions</h2>
          <details class="faq-item">
            <summary>Is Local SEO really included in the Custom build price, or is that extra?</summary>
            <p>It's included in the Custom build price &mdash; Google Business Profile setup, LocalBusiness schema, llms.txt and AI-crawler access, and a review-generation system, the same scope as our standalone Local SEO &amp; GEO service. You're not paying for the site and then paying again to make it findable.</p>
          </details>
          <details class="faq-item">
            <summary>What if I need customer accounts, bookings, or a database?</summary>
            <p>We build those. It's the same work as a website with more moving parts, and the size varies a lot: a simple booking form is a small job, a customer portal is a big one. That's why a fixed website price can't honestly cover it. Tell us what it needs to do, and we'll estimate the days up front and give you the price in writing. You approve it before we start. Bigger work is priced from <Price item="fixDay" /> per day of work.</p>
          </details>
          <details class="faq-item">
            <summary>Who owns the domain &mdash; us or you?</summary>
            <p>You. If you already have a domain, we connect it. If you don&rsquo;t, our default is to register it directly in your own registrar account so there&rsquo;s never a custody question &mdash; no lock-in, nothing to transfer later. If you&rsquo;d rather we register it first for speed, we hand it over via a standard domain transfer whenever you want it, using the authorization code your registrar provides. Either way, the first year&rsquo;s registration is included in the build price; renewal after that is yours.</p>
          </details>
        </article>

        <aside class="sidecard">
          <h4>Website builds</h4>
          <div class="label-row"><span>Best for</span><span>Local businesses</span></div>
          <div class="label-row"><span>Custom build</span><span><Price item="customBuild" /></span></div>
          <div class="label-row"><span>Care plan</span><span><Price item="carePlan" suffix="/mo" /></span></div>
          <div class="label-row"><span>Local SEO/GEO plans</span><span><Price item="monitor" to="scale" suffix="/mo" /></span></div>
          <div class="label-row"><span>Lock-in</span><span>None</span></div>
          <p style="font-size:12px;color:var(--text-muted);margin:10px 0 16px;">Built properly around your business, with Local SEO &amp; GEO included from day one, on hosting in your name.</p>
          <a class="btn btn-primary" href="/contact.html" data-umami-event="cta_click" data-umami-event-target="get_a_quote" data-umami-event-source="website_builds_sidecard">Get a quote &rarr;</a>
          <a class="btn btn-ghost" href="/services/local-seo.html">Already have a site? See Local SEO/GEO</a>
        </aside>
      </div>

      <div class="cta-banner" id="enquire" style="margin-top:72px;">
        <h2>Ready to get found?</h2>
        <p>Send us your business name, or your existing Google listing if you have one. We'll tell you which tier actually makes sense before you pay for anything.</p>
        <QuickEnquiry
          engagement="Website build (new site for my business)"
          source="website_builds_page"
          id="qe-web"
          messageLabel="Your business, and what the site needs to do"
          messagePlaceholder="e.g. Plumbing business in Parramatta. Our site is years old and we don't show up on Google Maps. Google listing: …"
        />
        <script is:inline defer src="/js/quick-enquiry.js?v=20261016"></script>
      </div>
    </div>
  </main>
</BaseLayout>
