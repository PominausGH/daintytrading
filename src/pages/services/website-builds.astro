---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pricing } from '../../data/pricing.ts';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Website Builds for Local Businesses',
    provider: { '@type': 'Organization', name: 'Dainty Trading', url: 'https://daintytrading.com' },
    serviceType: 'Website design and development',
    description: 'Website builds for local businesses without one — an instant page generated from an existing Google Business listing, or a custom-built site with Local SEO and GEO included from day one.',
    areaServed: 'AU',
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Website build packages',
      itemListElement: [
        { '@type': 'Offer', name: 'Instant page', price: String(pricing.instantPageFromUsd), priceCurrency: 'USD', description: `One-off, or from $${pricing.instantPageHostedFromUsd} USD/month hosted (from $${pricing.instantPageOwnDomainFromUsd} USD/month for your own domain). Auto-generated from your existing Google Business listing — name, address, hours, photos, and reviews. Live within days. Billed via bizpage.biz in USD.` },
        { '@type': 'Offer', name: 'Custom build', price: String(pricing.customBuild), priceCurrency: 'AUD', description: `One-off. Custom-designed site, copywriting, hosting, SSL, and Local SEO & GEO setup included — not sold separately. $${pricing.customBuildWithGrowthCommit.toLocaleString()} AUD if you commit to 12 months of the Growth plan.` },
        { '@type': 'Offer', name: 'Care plan', price: String(pricing.carePlan), priceCurrency: 'AUD', description: 'Monthly. Hosting, security updates, and small content changes for website clients. Attached to every custom build by default. Cancel anytime.' },
        { '@type': 'Offer', name: 'Monitor', price: String(pricing.monitor), priceCurrency: 'AUD', description: 'Monthly. Automated ranking and AI-citation monitoring, with a monthly plain-English report. No fix pass included. Cancel anytime.' },
        { '@type': 'Offer', name: 'Growth', price: String(pricing.growth), priceCurrency: 'AUD', description: 'Monthly. Everything in Monitor, plus Google Business Profile posts, review replies, and a review campaign each month. Cancel anytime.' },
        { '@type': 'Offer', name: 'Scale', price: String(pricing.scale), priceCurrency: 'AUD', description: 'Monthly. Everything in Growth, plus new suburb/service pages, full Google Business Profile management, monthly content, and a quarterly strategy call.' },
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: "What's the difference between the instant page and the custom build?", acceptedAnswer: { '@type': 'Answer', text: `The instant page is generated automatically from your existing Google Business listing and can be live within days, from $${pricing.instantPageFromUsd} USD (billed via bizpage.biz). The custom build is designed and written around your business specifically, with Local SEO & GEO included, for $${pricing.customBuild.toLocaleString()} AUD ($${pricing.customBuildWithGrowthCommit.toLocaleString()} AUD if you commit to 12 months of the Growth plan). Same underlying quality bar, different amount of hands-on work.` } },
      { '@type': 'Question', name: 'Why is the custom build cheaper if I commit to 12 months of Growth?', acceptedAnswer: { '@type': 'Answer', text: `It isn't cheaper overall — it's less money down. The $${(pricing.customBuild - pricing.customBuildWithGrowthCommit).toLocaleString()} off the build ($${pricing.customBuild.toLocaleString()} to $${pricing.customBuildWithGrowthCommit.toLocaleString()}) is smaller than the $${(pricing.growth * 12).toLocaleString()} you'll spend on 12 months of Growth at $${pricing.growth}/month, so the combined path costs more across the year, not less. It's there for businesses that would rather pay less upfront and spread the rest out monthly, not a way to get the same work for a lower total price.` } },
      { '@type': 'Question', name: 'Do I need the custom build, or is the instant page enough?', acceptedAnswer: { '@type': 'Answer', text: "If you just need to stop being invisible online today, the instant page usually does the job. The custom build makes sense once you want a site that says something specific about your business, or you're ready to actively invest in being found — we'll tell you honestly which one you actually need." } },
      { '@type': 'Question', name: 'Is Local SEO really included in the Custom build price, or is that extra?', acceptedAnswer: { '@type': 'Answer', text: "It's included in the Custom build price — Google Business Profile setup, LocalBusiness schema, llms.txt and AI-crawler access, and a review-generation system, the same scope as our standalone Local SEO & GEO service. You're not paying for the site and then paying again to make it findable." } },
      { '@type': 'Question', name: 'What if I need customer accounts, bookings, or a database?', acceptedAnswer: { '@type': 'Answer', text: "That's a different service — an AI product build, not a website. A login system or booking flow has its own scope and cost that a fixed website price can't honestly cover, so we quote those separately once we know what it actually needs to do." } },
      { '@type': 'Question', name: 'Can I start with the instant page and upgrade later?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Plenty of businesses start with the instant page to get something live immediately, then move to a custom build once they know what they want the site to do for them.' } },
      { '@type': 'Question', name: 'Who owns the domain — us or you?', acceptedAnswer: { '@type': 'Answer', text: "You. If you already have a domain, we connect it. If you don't, our default is to register it directly in your own registrar account so there's never a custody question — no lock-in, nothing to transfer later. If you'd rather we register it first for speed, we hand it over via a standard domain transfer whenever you want it, using the authorization code your registrar provides. Either way, the first year's registration is included in the build price; renewal after that is yours." } },
    ],
  },
];
---
<BaseLayout
  title="Website Builds for Local Businesses — Custom Sites with Local SEO Built In | Dainty Trading"
  description="Website builds for local businesses without one. Start with an instant page generated from your Google listing from $149 USD, or a custom-built site with Local SEO &amp; GEO included for $6,900 AUD ($4,900 with a 12-month Growth commitment). No lock-in."
  canonicalPath="/services/website-builds.html"
  jsonLd={jsonLd}
>
  <style>
    .price-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin:10px 0; }
    @media (max-width:980px) { .price-grid { grid-template-columns:1fr; } }
    .price-card { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:24px; display:flex; flex-direction:column; }
    .price-card.featured { border-color:var(--accent); box-shadow:var(--shadow); }
    .price-card .tier { font-size:13px; letter-spacing:.04em; text-transform:uppercase; color:var(--text-muted); }
    .price-card .price { font-size:30px; font-weight:700; margin:6px 0 2px; color:var(--text); }
    .price-card .price small { font-size:14px; font-weight:500; color:var(--text-muted); }
    .price-card .note { font-size:12.5px; color:var(--text-muted); margin:0 0 14px; }
    .price-card ul { list-style:none; padding:0; margin:6px 0 18px; flex:1; }
    .price-card li { font-size:14px; color:var(--text-dim); padding:7px 0 7px 22px; position:relative; border-top:1px solid var(--border); }
    .price-card li:first-child { border-top:none; }
    .price-card li::before { content:"\2713"; position:absolute; left:0; color:var(--accent); font-weight:700; }
    .price-card .btn { width:100%; text-align:center; }
    .price-badge { display:inline-block; font-size:11px; text-transform:uppercase; letter-spacing:.05em; background:var(--accent-soft); color:var(--accent); padding:3px 9px; border-radius:999px; margin-bottom:10px; }
    .month-list { list-style:none; padding:0; margin:6px 0 0; }
    .month-list li { font-size:13.5px; color:var(--text-dim); padding:5px 0 5px 20px; position:relative; border:none; }
    .month-list li::before { content:"\2192"; position:absolute; left:0; color:var(--text-muted); font-weight:400; }
    .honest-note { background:var(--accent-soft); border:1px solid var(--border); border-radius:var(--radius-sm); padding:14px 16px; font-size:14px; color:var(--text-dim); margin:22px 0; }
    .honest-note strong { color:var(--text); }
  </style>

  <main id="main">
    <section class="detail-hero">
      <div class="container">
        <div class="crumbs"><a href="/">Home</a> &nbsp;/&nbsp; <a href="/services.html">Services</a> &nbsp;/&nbsp; Website builds</div>
        <h1>Website Builds &mdash; From an Instant Page to a Full Custom Site</h1>
        <p class="lede">Some businesses just need to stop being invisible online today. Others need a real site built around them. We do both &mdash; and the ones we build custom come with Local SEO &amp; GEO switched on from day one, not sold to you later as a separate line item.</p>
      </div>
    </section>

    <div class="container">
      <div class="detail-body">
        <article class="prose">
          <h2>Who this is for</h2>
          <p>Local businesses with no website at all, or one that's old, DIY, and doing them no favours &mdash; tradies, clinics, home services, anyone whose customers are local and searching for them right now. If that's you, there's a starting point here whether you want something live this week or something built properly around your business.</p>

          <h2>Packages</h2>
          <div class="price-grid">
            <div class="price-card">
              <span class="tier">Instant page</span>
              <div class="price">from {pricing.instantPageFromUsd} USD <small>one-off</small></div>
              <p class="note">Or from {pricing.instantPageHostedFromUsd} USD/month hosted. Live within days. Billed in USD via bizpage.biz.</p>
              <ul>
                <li>Generated from your existing Google Business listing</li>
                <li>Name, address, hours, photos, and reviews pulled in automatically</li>
                <li>Free preview before you pay anything</li>
                <li>Hosting &amp; SSL from {pricing.instantPageHostedFromUsd} USD/month (free subdomain); connect a domain you already own from {pricing.instantPageOwnDomainFromUsd} USD/month (domain registration itself is separate, ~$10&ndash;$50/yr via any registrar)</li>
              </ul>
              <a class="btn btn-primary" href="https://bizpage.biz" target="_blank" rel="noopener">Get your free preview &rarr;</a>
              <a class="btn btn-ghost" href="https://bizpage.biz/sites/demo/plumber" target="_blank" rel="noopener" style="margin-top:8px;">See an example &rarr;</a>
            </div>

            <div class="price-card featured">
              <span class="price-badge">Most popular</span>
              <span class="tier">Custom build</span>
              <div class="price">{pricing.customBuild.toLocaleString()} AUD <small>one-off</small></div>
              <p class="note">Designed and written around your business, no lock-in. {pricing.customBuildWithGrowthCommit.toLocaleString()} AUD if you commit to 12 months of the Growth plan below &mdash; less money down, not a cheaper total: 12 months of Growth is ${(pricing.growth * 12).toLocaleString()}, so you end up paying more overall in exchange for a lower price today.</p>
              <ul>
                <li>Custom design and copywriting &mdash; not a template</li>
                <li>Hosting, SSL, and your domain &mdash; connected if you already have one, or registered in your name if you don&rsquo;t (first year included)</li>
                <li>Local SEO &amp; GEO setup included, not sold separately</li>
                <li>LocalBusiness schema, service-area pages, llms.txt</li>
                <li>A system to turn happy customers into reviews</li>
              </ul>
              <a class="btn btn-primary" href="/contact.html">Get a quote &rarr;</a>
            </div>

            <div class="price-card">
              <span class="tier">Care plan <small style="text-transform:none;letter-spacing:0;">&mdash; monthly</small></span>
              <div class="price">{pricing.carePlan} AUD<small>/mo</small></div>
              <p class="note">Attached to every custom build by default &mdash; opt out if you&rsquo;d rather self-manage.</p>
              <ul class="month-list">
                <li>Hosting, SSL renewal, and uptime monitoring</li>
                <li>Software and security updates</li>
                <li>Small changes &mdash; text edits, photo swaps, a new testimonial</li>
              </ul>
              <a class="btn btn-ghost" href="/contact.html" style="margin-top:16px;">Talk it through &rarr;</a>
            </div>
          </div>

          <h3 style="margin-top:28px;">Then, optional Local SEO &amp; GEO plans</h3>
          <p style="font-size:14px;color:var(--text-dim);margin:0 0 16px;">Same product as our <a href="/services/local-seo.html">standalone Local SEO &amp; GEO service</a> &mdash; three tiers, cancel anytime. Commit to 12 months of Growth and your Custom build drops to {pricing.customBuildWithGrowthCommit.toLocaleString()} AUD &mdash; lower money down, not a lower total (see the Custom build note above).</p>
          <div class="price-grid">
            <div class="price-card">
              <span class="tier">Monitor <small style="text-transform:none;letter-spacing:0;">&mdash; monthly</small></span>
              <div class="price">{pricing.monitor} AUD<small>/mo</small></div>
              <p class="note">Watch it, report on it, no fix pass included.</p>
              <ul class="month-list">
                <li>Automated ranking &amp; AI-citation monitoring</li>
                <li>A plain-English report: searches, visitors, calls</li>
              </ul>
              <a class="btn btn-ghost" href="/contact.html" style="margin-top:16px;">Talk it through &rarr;</a>
            </div>

            <div class="price-card featured">
              <span class="price-badge">Most popular</span>
              <span class="tier">Growth <small style="text-transform:none;letter-spacing:0;">&mdash; monthly</small></span>
              <div class="price">{pricing.growth} AUD<small>/mo</small></div>
              <p class="note">Monitor, plus we keep working your listing. 12-month commitment drops your Custom build to {pricing.customBuildWithGrowthCommit.toLocaleString()} AUD &mdash; less money down, not a lower total (see the Custom build note above).</p>
              <ul class="month-list">
                <li>Google Business Profile posts &amp; review replies</li>
                <li>A review campaign to that month&rsquo;s customers</li>
              </ul>
              <a class="btn btn-primary" href="/contact.html" style="margin-top:16px;">Talk it through &rarr;</a>
            </div>

            <div class="price-card">
              <span class="tier">Scale <small style="text-transform:none;letter-spacing:0;">&mdash; monthly</small></span>
              <div class="price">{pricing.scale.toLocaleString()} AUD<small>/mo</small></div>
              <p class="note">For businesses actively expanding into new areas.</p>
              <ul class="month-list">
                <li>New suburb/service pages each month</li>
                <li>Full Google Business Profile management</li>
                <li>A quarterly strategy call</li>
              </ul>
              <a class="btn btn-ghost" href="/contact.html" style="margin-top:16px;">Talk it through &rarr;</a>
            </div>
          </div>

          <div class="honest-note">
            <strong>Not sure which one you need?</strong> If you just need to be findable today, start with the instant page &mdash; it's free to preview and there's no obligation. If you want a site that says something specific about your business and you're ready to actively invest in being found, go straight to the custom build. We'll tell you plainly if you're paying for more than you need.
          </div>

          <h2>Why us</h2>
          <p><strong>Real hosted software, not a template.</strong> Both tiers ship a working, hosted site with SSL &mdash; not a design file you then have to get built.</p>
          <p><strong>SEO/GEO built in, not bolted on later.</strong> The custom build includes the same Local SEO &amp; GEO scope as our standalone service, so you're not found nowhere for months while you save up for a second project.</p>
          <p><strong>We tell you which tier you actually need.</strong> Plenty of businesses only need the instant page. We'd rather say that than upsell you.</p>

          <h2>What this is not</h2>
          <p>Not the right fit if you need customer logins, a booking system, payments, or anything else with real application logic behind it &mdash; that's a different kind of build with its own scope and cost. See <a href="/services/ai-product-builds.html">AI product builds</a> for that instead. This page is about getting a local business properly online and found, not about building software.</p>

          <h2>What a client says</h2>
          <figure class="testimonial-card">
            <blockquote class="testimonial-quote">&ldquo;We engaged Andrew to have a look at our website,he explained what he needed to do and fixed everything and we our now getting lots more jobs through from.the internet traffic He also built a new website for a new branch of the business The work is fantastic and he absolutely nalied it Its about time we spent some money and got the return you hope for After several companies I have found the one I will be sticking with&rdquo;</blockquote>
            <figcaption class="testimonial-caption">
              <span class="testimonial-stars">★★★★★</span>&nbsp;
              <strong class="testimonial-name">Craig Smith</strong> &middot; Local Guide &middot; <a href="https://www.google.com/maps/place/?q=place_id:ChIJ2VLpW3U4aoQRz6YI6UQ2hr4" target="_blank" rel="noopener" class="link-dim">Google review</a> &middot; <a href="/projects/new-shutter-business.html" class="link-dim">read the case study</a>
            </figcaption>
          </figure>

          <h2>Frequently asked questions</h2>
          <details class="faq-item">
            <summary>What's the difference between the instant page and the custom build?</summary>
            <p>The instant page is generated automatically from your existing Google Business listing and can be live within days, from {pricing.instantPageFromUsd} USD (billed via bizpage.biz). The custom build is designed and written around your business specifically, with Local SEO &amp; GEO included, for {pricing.customBuild.toLocaleString()} AUD ({pricing.customBuildWithGrowthCommit.toLocaleString()} AUD if you commit to 12 months of the Growth plan). Same underlying quality bar, different amount of hands-on work.</p>
          </details>
          <details class="faq-item">
            <summary>Why is the custom build cheaper if I commit to 12 months of Growth?</summary>
            <p>It isn&rsquo;t cheaper overall &mdash; it&rsquo;s less money down. The ${(pricing.customBuild - pricing.customBuildWithGrowthCommit).toLocaleString()} off the build ({pricing.customBuild.toLocaleString()} to {pricing.customBuildWithGrowthCommit.toLocaleString()}) is smaller than the ${(pricing.growth * 12).toLocaleString()} you&rsquo;ll spend on 12 months of Growth at {pricing.growth}/month, so the combined path costs more across the year, not less. It&rsquo;s there for businesses that would rather pay less upfront and spread the rest out monthly, not a way to get the same work for a lower total price.</p>
          </details>
          <details class="faq-item">
            <summary>Do I need the custom build, or is the instant page enough?</summary>
            <p>If you just need to stop being invisible online today, the instant page usually does the job. The custom build makes sense once you want a site that says something specific about your business, or you're ready to actively invest in being found &mdash; we'll tell you honestly which one you actually need.</p>
          </details>
          <details class="faq-item">
            <summary>Is Local SEO really included in the Custom build price, or is that extra?</summary>
            <p>It's included in the Custom build price &mdash; Google Business Profile setup, LocalBusiness schema, llms.txt and AI-crawler access, and a review-generation system, the same scope as our standalone Local SEO &amp; GEO service. You're not paying for the site and then paying again to make it findable.</p>
          </details>
          <details class="faq-item">
            <summary>What if I need customer accounts, bookings, or a database?</summary>
            <p>That's a different service &mdash; an AI product build, not a website. A login system or booking flow has its own scope and cost that a fixed website price can't honestly cover, so we quote those separately once we know what it actually needs to do.</p>
          </details>
          <details class="faq-item">
            <summary>Can I start with the instant page and upgrade later?</summary>
            <p>Yes. Plenty of businesses start with the instant page to get something live immediately, then move to a custom build once they know what they want the site to do for them.</p>
          </details>
          <details class="faq-item">
            <summary>Who owns the domain &mdash; us or you?</summary>
            <p>You. If you already have a domain, we connect it. If you don&rsquo;t, our default is to register it directly in your own registrar account so there&rsquo;s never a custody question &mdash; no lock-in, nothing to transfer later. If you&rsquo;d rather we register it first for speed, we hand it over via a standard domain transfer whenever you want it, using the authorization code your registrar provides. Either way, the first year&rsquo;s registration is included in the build price; renewal after that is yours.</p>
          </details>
        </article>

        <aside class="sidecard">
          <h4>Website builds</h4>
          <div class="label-row"><span>Best for</span><span>Local businesses without a site</span></div>
          <div class="label-row"><span>Instant page</span><span>from {pricing.instantPageFromUsd} USD</span></div>
          <div class="label-row"><span>Custom build</span><span>{pricing.customBuild.toLocaleString()} AUD</span></div>
          <div class="label-row"><span>Custom build + 12mo Growth</span><span>{pricing.customBuildWithGrowthCommit.toLocaleString()} AUD</span></div>
          <div class="label-row"><span>Care plan</span><span>{pricing.carePlan} AUD/mo</span></div>
          <div class="label-row"><span>Local SEO/GEO plans</span><span>{pricing.monitor}&ndash;{pricing.scale.toLocaleString()} AUD/mo</span></div>
          <div class="label-row"><span>Lock-in</span><span>None</span></div>
          <p style="font-size:12px;color:var(--text-muted);margin:10px 0 16px;">Live within days with the instant page, or built properly around your business with Local SEO &amp; GEO included from day one.</p>
          <a class="btn btn-primary" href="/contact.html">Get a quote &rarr;</a>
          <a class="btn btn-ghost" href="/services/local-seo.html">Already have a site? See Local SEO/GEO</a>
        </aside>
      </div>

      <div class="cta-banner" style="margin-top:72px;">
        <h2>Ready to get found?</h2>
        <p>Send us your business name, or your existing Google listing if you have one. We'll tell you which tier actually makes sense before you pay for anything.</p>
        <a class="btn btn-primary" href="/contact.html">Get a quote &rarr;</a>
      </div>
    </div>
  </main>
</BaseLayout>
