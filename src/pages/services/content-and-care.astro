---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Price from '../../components/Price.astro';
import CurrencySwitch from '../../components/CurrencySwitch.astro';
import QuickEnquiry from '../../components/QuickEnquiry.astro';
import { pricing, aud } from '../../data/pricing.ts';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Website Care and Monthly SEO & GEO Content',
    provider: { '@type': 'Organization', name: 'TelaLoom', url: 'https://telaloom.com' },
    serviceType: 'Website maintenance, page updates, and SEO & GEO blog content',
    description: 'Monthly website page updates, schema and sitemap upkeep, passive uptime monitoring on your own hosting, and researched, fact-checked SEO and AI-search articles published to your site each month.',
    areaServed: 'Worldwide',
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Website Care & Content plans',
      itemListElement: [
        { '@type': 'Offer', name: 'Care plan', price: String(pricing.carePlan), priceCurrency: 'AUD', description: 'Monthly, no GST. Up to 60 minutes of page updates per month (text edits, photo swaps, price changes, new testimonials), schema and sitemap kept in sync, and passive uptime and SSL monitoring on your own hosting. 2-business-day response time, same business day for urgent issues. Cancel anytime.' },
        { '@type': 'Offer', name: 'Care + Content', price: String(pricing.carePlusContent), priceCurrency: 'AUD', description: 'Monthly, no GST. Everything in the Care plan, plus 2 researched, fact-checked SEO and AI-search articles or suburb guides published to your site each month after your sign-off. Cancel anytime.' },
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'Can I sign up if TelaLoom did not build my website?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. As long as we can push updates to your site (via Git, Astro, Next.js, plain HTML, or your CMS) we can look after your page edits and publish monthly articles. We check your site first and confirm we can work with your setup before you pay anything.' } },
      { '@type': 'Question', name: 'Do I get to approve the blog topics and articles before they go live?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. When you start, we draft a list of real customer questions and suburb or service topics for your sign-off. Each month we send the finished, fact-checked draft for your OK before publishing.' } },
      { '@type': 'Question', name: 'Who hosts the website?', acceptedAnswer: { '@type': 'Answer', text: 'You do, on an account in your own name, and you pay your hosting provider directly. We do not host client websites or mark up hosting bills, so you are never locked in. Hosting uptime and backups stay with your hosting provider.' } },
      { '@type': 'Question', name: 'What counts as the 60 minutes of monthly page updates?', acceptedAnswer: { '@type': 'Answer', text: 'Everyday changes to existing pages: updating prices or hours, swapping photos, adding a new staff bio or testimonial, updating FAQs, or fixing broken links — plus keeping your structured data (schema) and sitemap in sync. Unused minutes do not roll over; larger additions like new custom features are quoted up front in writing.' } },
      { '@type': 'Question', name: 'Is there a minimum contract?', acceptedAnswer: { '@type': 'Answer', text: 'No. Both Care and Care + Content are month-to-month. Cancel anytime, effective at the end of the current billing month.' } },
    ],
  },
];
---
<BaseLayout
  currencySwitch
  title="Website Care & Monthly SEO/GEO Content — Page Updates & Blog Articles | TelaLoom"
  description={`Website updates without agency lock-in: up to 60 mins/month of edits from ${aud(pricing.carePlan)} AUD/mo, or add 2 SEO & AI-search articles a month.`}
  canonicalPath="/services/content-and-care.html"
  jsonLd={jsonLd}
>
  <style>
    .price-grid--two { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; margin:10px 0; }
    @media (max-width:980px) { .price-grid--two { grid-template-columns:1fr; } }
    .price-card { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:24px; display:flex; flex-direction:column; }
    .price-card.featured { border-color:var(--accent); box-shadow:var(--shadow); }
    .price-card .tier { font-size:13px; letter-spacing:.04em; text-transform:uppercase; color:var(--text-muted); }
    .price-card .price { font-size:30px; font-weight:700; margin:6px 0 2px; color:var(--text); }
    .price-card .price small { font-size:14px; font-weight:500; color:var(--text-muted); white-space:nowrap; }
    .price-card .note { font-size:12.5px; color:var(--text-muted); margin:0 0 14px; }
    .price-card ul { list-style:none; padding:0; margin:6px 0 18px; flex:1; }
    .price-card li { font-size:14px; color:var(--text-dim); padding:7px 0 7px 22px; position:relative; border-top:1px solid var(--border); }
    .price-card li:first-child { border-top:none; }
    .price-card li::before { content:"\2713"; position:absolute; left:0; color:var(--accent); font-weight:700; }
    .price-card .btn { width:100%; text-align:center; }
    .price-badge { display:inline-block; font-size:11px; text-transform:uppercase; letter-spacing:.05em; background:var(--accent-soft); color:var(--accent); padding:3px 9px; border-radius:999px; margin-bottom:10px; }
    .honest-note { background:var(--accent-soft); border:1px solid var(--border); border-radius:var(--radius-sm); padding:14px 16px; font-size:14px; color:var(--text-dim); margin:22px 0; }
    .honest-note strong { color:var(--text); }
    .build-steps { list-style:none; padding:0; margin:18px 0 8px; counter-reset:step; }
    .build-steps li { position:relative; padding:0 0 22px 56px; margin:0; }
    .build-steps li::before { counter-increment:step; content:counter(step); position:absolute; left:0; top:0; width:36px; height:36px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:15px; background:var(--accent-soft); color:var(--accent-text); border:1px solid var(--border); }
    .build-steps li::after { content:""; position:absolute; left:18px; top:40px; bottom:4px; width:1px; background:var(--border); }
    .build-steps li:last-child::after { display:none; }
    .build-steps .when { display:block; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--accent-text); margin-bottom:2px; }
    .build-steps h3 { font-size:17px; margin:0 0 6px; }
    .build-steps p { font-size:14.5px; color:var(--text-dim); margin:0; }
    #plans, #enquire { scroll-margin-top:88px; }
  </style>

  <main id="main">
    <section class="detail-hero">
      <div class="container">
        <div class="crumbs"><a href="/">Home</a> &nbsp;/&nbsp; <a href="/services.html">Services</a> &nbsp;/&nbsp; Website Care &amp; Content</div>
        <h1>Website Care &amp; Monthly SEO/GEO Content</h1>
        <p class="lede">Most small business websites go stale the week after they launch: prices change, photos get old, and no new pages ever go up. We handle your everyday page edits and publish steady, fact-checked articles built to get quoted by Google and AI assistants &mdash; on your own hosting, with no lock-in.</p>
      </div>
    </section>

    <div class="container">
      <div class="detail-body">
        <article class="prose">
          <h2>Who this is for</h2>
          <p>Business owners who already have a website (whether we built it or not) and want two things without paying a large agency retainer: someone they can email whenever a page needs changing, and steady, well-researched articles that answer the exact questions their customers type into Google and ChatGPT.</p>

          <h2 id="plans">Monthly plans</h2>
          <p>Month-to-month, cancel anytime. Your site stays on hosting in your own name &mdash; we just push the content and page updates.</p>
          <CurrencySwitch />
          <div class="price-grid--two">
            <div class="price-card">
              <span class="tier">Care plan <small style="text-transform:none;letter-spacing:0;">&mdash; monthly</small></span>
              <div class="price"><Price item="carePlan" /><small>/mo, no GST</small></div>
              <p class="note">For business owners who want their pages kept up to date without logging into a CMS or codebase.</p>
              <ul>
                <li>Up to 60 minutes/month of small page changes &mdash; text edits, price updates, photo swaps, a new testimonial or FAQ (unused time doesn&rsquo;t roll over; extra work billed at our standard hourly rate)</li>
                <li>Schema markup, internal links and <code>sitemap.xml</code> kept in sync whenever your pages change</li>
                <li>Passive uptime, SSL and broken-page monitoring on your own hosting</li>
                <li>2-business-day response time &mdash; same business day if the site is down or a form stops working (<a href="/support.html">response times</a>)</li>
              </ul>
              <a class="btn btn-ghost" href="#enquire" data-umami-event="cta_click" data-umami-event-target="talk_it_through" data-umami-event-source="content_care_plan">Start Care &rarr;</a>
            </div>

            <div class="price-card featured">
              <span class="price-badge">Most popular</span>
              <span class="tier">Care + Content <small style="text-transform:none;letter-spacing:0;">&mdash; monthly</small></span>
              <div class="price"><Price item="carePlusContent" /><small>/mo, no GST</small></div>
              <p class="note">Everything in Care, plus steady SEO &amp; AI-search articles so Google and ChatGPT keep finding fresh answers on your site.</p>
              <ul>
                <li>Everything in the Care plan (60 mins/month of page updates, schema/sitemap sync, uptime &amp; SSL alerts)</li>
                <li>2 researched, fact-checked SEO &amp; AI-search articles or suburb guides published to your site each month</li>
                <li>Structured in direct question-and-answer format with <code>FAQPage</code> schema so AI assistants and Google AI Overviews can quote you directly</li>
                <li>Run through our 6-stage quality and double-pass fact-check pipeline (<a href="/projects/ghost-writer.html">how our content engine works</a>) and reviewed by hand</li>
                <li>Sent to you for sign-off before anything goes live, with internal links to your older posts and <code>sitemap.xml</code> updated automatically</li>
              </ul>
              <a class="btn btn-primary" href="#enquire" data-umami-event="cta_click" data-umami-event-target="talk_it_through" data-umami-event-source="content_care_plus_content">Start Care + Content &rarr;</a>
            </div>
          </div>

          <div class="honest-note">
            <strong>Need local rankings and Google Business Profile management too?</strong> Pair either plan with our <a href="/services/local-seo.html">Local SEO &amp; GEO</a> or <a href="/services/seo-geo-optimization.html">SEO &amp; GEO</a> plans, or start with the <a href="/site-check.html">free website check</a> if you aren&rsquo;t sure what your site needs first.
          </div>

          <h2>How the monthly articles work</h2>
          <p>Generic AI blog posts full of made-up statistics hurt your credibility. Our content pipeline (<a href="/projects/ghost-writer.html">Ghost Writer</a>) was built to solve that on our own sites first, with strict accuracy rules, double-pass fact-checking, and human review before anything publishes:</p>
          <ol class="build-steps">
            <li>
              <span class="when">Step 1 &middot; Onboarding</span>
              <h3>You approve the topic list up front</h3>
              <p>We research the real questions your customers ask on Google and in AI assistants, put together a queue of article and suburb-guide topics tailored to your business, and send it to you. You cross out anything you don&rsquo;t want covered.</p>
            </li>
            <li>
              <span class="when">Step 2 &middot; Drafting &amp; Fact-Checking</span>
              <h3>6-stage pipeline + human editorial check</h3>
              <p>Each article is written to your brand voice with zero invented stats, checked twice by our automated fact-checker against your real business details, and reviewed by hand.</p>
            </li>
            <li>
              <span class="when">Step 3 &middot; Your Sign-Off</span>
              <h3>You review before it goes live</h3>
              <p>We send you the finished draft. Tell us if you want anything changed; nothing publishes without your OK.</p>
            </li>
            <li>
              <span class="when">Step 4 &middot; Publish &amp; Interlink</span>
              <h3>Published to your site with schema and internal links</h3>
              <p>We publish the article directly to your site, add <code>FAQPage</code> and article schema, update your <code>sitemap.xml</code>, and automatically link related older posts to the new one.</p>
            </li>
          </ol>

          <h2>You keep your own hosting (zero lock-in)</h2>
          <p>We don&rsquo;t host client websites or resell hosting. Your website stays on an account in your own name (Cloudflare Pages, Vercel, Netlify, WordPress, or your own host), and you pay your host directly. You give us Git or editor access so we can ship your page edits and publish your articles, and hosting infrastructure, uptime and backups remain between you and your hosting provider.</p>

          <h2>Frequently asked questions</h2>
          <details class="faq-item">
            <summary>Can I sign up if TelaLoom didn&rsquo;t build my website?</summary>
            <p>Yes. As long as we can push updates to your site (via Git, Astro, Next.js, plain HTML, or your CMS) we can look after your page edits and publish monthly articles. We check your site first and confirm we can work with your setup before you pay anything.</p>
          </details>
          <details class="faq-item">
            <summary>Do I get to approve the blog topics and articles before they go live?</summary>
            <p>Yes. When you start, we draft a list of real customer questions and suburb or service topics for your sign-off. Each month we send the finished, fact-checked draft for your OK before publishing.</p>
          </details>
          <details class="faq-item">
            <summary>Who hosts the website?</summary>
            <p>You do, on an account in your own name, and you pay your hosting provider directly. We don&rsquo;t host client websites or mark up hosting bills, so you&rsquo;re never locked in. Hosting uptime and backups stay with your hosting provider.</p>
          </details>
          <details class="faq-item">
            <summary>What counts as the 60 minutes of monthly page updates?</summary>
            <p>Everyday changes to existing pages: updating prices or hours, swapping photos, adding a new staff bio or testimonial, updating FAQs, or fixing broken links &mdash; plus keeping your structured data (schema) and sitemap in sync. Unused minutes don&rsquo;t roll over; larger additions like new custom features are quoted up front in writing.</p>
          </details>
          <details class="faq-item">
            <summary>Is there a minimum contract?</summary>
            <p>No. Both Care and Care + Content are month-to-month. Cancel anytime, effective at the end of the current billing month.</p>
          </details>
        </article>

        <aside class="sidecard">
          <h4>Care &amp; Content</h4>
          <div class="label-row"><span>Care plan</span><span><Price item="carePlan" suffix="/mo" /></span></div>
          <div class="label-row"><span>Care + Content</span><span><Price item="carePlusContent" suffix="/mo" /></span></div>
          <div class="label-row"><span>Page edits included</span><span>Up to 60 mins/mo</span></div>
          <div class="label-row"><span>Articles (Care + Content)</span><span>2 / month</span></div>
          <div class="label-row"><span>Hosting</span><span>In your name</span></div>
          <div class="label-row"><span>Lock-in</span><span>None</span></div>
          <p style="font-size:12px;color:var(--text-muted);margin:10px 0 16px;">Month-to-month. We confirm your site setup is compatible before you pay anything.</p>
          <a class="btn btn-primary" href="#enquire" data-umami-event="cta_click" data-umami-event-target="get_a_quote" data-umami-event-source="content_care_sidecard">Get started &rarr;</a>
          <a class="btn btn-ghost" href="/site-check.html">Free website check</a>
        </aside>
      </div>

      <div class="cta-banner" id="enquire" style="margin-top:72px;">
        <h2>Want us to look after your pages and content?</h2>
        <p>Send us your website address and tell us whether you want Care or Care + Content. We&rsquo;ll check your setup and reply within one business day.</p>
        <QuickEnquiry
          engagement="Website care & monthly content"
          source="content_care_page"
          id="qe-care"
          messageLabel="Your website URL, and what you'd like us to look after"
          messagePlaceholder="e.g. https://example.com.au — we want Care + Content (2 articles a month + occasional price and photo updates)."
        />
        <script is:inline defer src="/js/quick-enquiry.js?v=20261016"></script>
      </div>
    </div>
  </main>
</BaseLayout>
