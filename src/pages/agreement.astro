---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Website Brief & Agreement — TelaLoom"
  description="Tell us about your project, review the scope and fees, and sign your web design agreement with TelaLoom online."
  canonicalPath="/agreement.html"
  robots="noindex, nofollow"
  chrome="full"
>
<!--
  CONFIG
  - WEBHOOK_URL: points at the n8n "Web Design Agreement" webhook. The client's browser posts
    to it automatically right after signing (no manual click needed) — see sendRecord(). n8n
    stores the record, renders a PDF (by fetching this page, injecting window.__PREFILL__, and
    printing it via Gotenberg), and emails TelaLoom a countersign link + the client a receipt.
  - Prefill: any TEXT/checkbox/select field can be prefilled via query string using its name
    attribute, e.g. ?client_name=Darren%20Smith&project_name=New%20site&total_fee=%243%2C500
    Checkbox groups take comma-separated values: ?pages=Home,About,Contact
  - ?lock=project makes the Project & fees section read-only for the client.
  - ?countersign=1&ref=<reference>&token=<countersign_token>: the link n8n emails TelaLoom after a client signs.
    Reveals the provider signature box (hidden from clients — see allowCountersign) immediately
    on load, and once countersigned, posts a minimal {event:'countersign_only', reference, ...}
    payload that the webhook merges with the original client-signed record it already has on file.
    This is NOT the same as window.__PREFILL__ (server-side-only, used for PDF rendering) —
    a page opened this way does not have the client's signature in memory, by design.
-->
<style>
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; scroll-padding-top:108px; }
  @media (prefers-reduced-motion:reduce){ html{scroll-behavior:auto;} }

  .agreement-hero .lede { max-width: 60ch; }

  nav.steps { position:sticky; top:0; z-index:10; background:rgba(10,12,16,0.9); backdrop-filter:saturate(140%) blur(14px); border-bottom:1px solid var(--border); }
  .steps-inner { max-width:820px; margin:0 auto; display:flex; gap:4px; align-items:center; padding:8px 12px; overflow-x:auto; }
  .steps a { flex:0 0 auto; text-decoration:none; color:var(--text-muted); font-size:14px; padding:6px 10px; border-radius:6px; white-space:nowrap; }
  .steps a b { display:inline-grid; place-items:center; width:20px; height:20px; border-radius:50%; border:1px solid var(--border-strong); font-size:12px; margin-right:6px; font-weight:600; }
  .steps a:hover { background:var(--bg-elev); color:var(--text); text-decoration:none; }
  .steps .spacer { flex:1; }
  .steps .btn.small { padding:6px 12px; font-size:14px; }
  .btn:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible, canvas:focus-visible, a:focus-visible { outline:3px solid var(--accent); outline-offset:2px; }

  #doc { max-width:820px; margin:0 auto; padding:24px 16px 80px; }
  section.sheet { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:28px clamp(18px,4vw,36px); margin-bottom:22px; }
  section.sheet h2 { font-size:22px; line-height:1.25; color:var(--text); margin:0 0 4px; font-weight:700; }
  section.sheet .sub { color:var(--text-muted); margin:0 0 20px; font-size:15px; }
  section.sheet h3 { font-size:16px; font-weight:600; color:var(--text); margin:26px 0 12px; padding-top:18px; border-top:1px solid var(--border); }
  section.sheet h3:first-of-type { border-top:0; padding-top:0; margin-top:8px; }

  .grid { display:grid; grid-template-columns:1fr 1fr; gap:14px 18px; }
  .grid .full { grid-column:1/-1; }
  @media (max-width:620px){ .grid{ grid-template-columns:1fr; } }
  label.f { display:block; font-size:14px; font-weight:500; color:var(--text); }
  label.f span.hint { font-weight:400; color:var(--text-muted); }
  label.f .req { color:var(--warn); }
  #doc input[type=text], #doc input[type=email], #doc input[type=tel], #doc input[type=url], #doc input[type=date], #doc textarea, #doc select {
    display:block; width:100%; margin-top:5px; font:16px var(--font-sans); color:var(--text);
    border:1px solid var(--border); border-radius:var(--radius-sm); padding:9px 11px; background:var(--bg-elev);
  }
  #doc textarea { min-height:84px; resize:vertical; }
  #doc fieldset { border:0; padding:0; margin:0; }
  #doc legend { font-size:14px; font-weight:500; margin-bottom:6px; padding:0; color:var(--text); }
  .opts { display:flex; flex-wrap:wrap; gap:8px; }
  .opts label { display:flex; align-items:center; gap:7px; border:1px solid var(--border); border-radius:var(--radius-sm); padding:7px 11px; font-size:15px; cursor:pointer; background:var(--bg-elev); color:var(--text-dim); }
  .opts label:has(input:checked) { border-color:var(--accent); background:var(--accent-soft); color:var(--text); }
  .opts input { accent-color:var(--accent); margin:0; }
  .invalid { border-color:var(--warn) !important; box-shadow:0 0 0 2px rgba(255,181,71,0.25); }

  .note { background:var(--bg-elev); border-left:3px solid var(--accent); padding:10px 14px; font-size:14px; color:var(--text-dim); border-radius:0 6px 6px 0; margin:0 0 18px; }

  .terms h4 { font-size:16px; font-weight:600; color:var(--text); margin:22px 0 8px; }
  .terms p { margin:0 0 8px; padding-left:40px; text-indent:-40px; font-size:15px; max-width:72ch; color:var(--text-dim); }
  .terms p b { display:inline-block; width:40px; text-indent:0; color:var(--text); }

  /* Signature pad: deliberately paper-coloured regardless of theme — it's meant to read
     as "sign here on paper," and it keeps the captured ink legible in the printed PDF too. */
  .sigs { display:grid; grid-template-columns:1fr 1fr; gap:22px; }
  .sigs:has(.sig[hidden]) { grid-template-columns:1fr; max-width:380px; }
  @media (max-width:720px){ .sigs{ grid-template-columns:1fr; max-width:none; } }
  .sig { border:1px solid var(--border); border-radius:var(--radius); padding:16px; }
  .sig h4 { margin:0 0 12px; font-size:15px; font-weight:600; color:var(--text); }
  .pad-wrap { position:relative; margin:12px 0 8px; background:#FCFCFD; border:1px dashed #CCD4DD; border-radius:var(--radius-sm); }
  .pad-wrap::before { content:"×"; position:absolute; left:14px; bottom:26px; font:22px Georgia,serif; color:#9AA7B4; pointer-events:none; }
  .pad-wrap::after { content:""; position:absolute; left:12px; right:12px; bottom:28px; border-bottom:1.5px solid #9AA7B4; pointer-events:none; }
  canvas.pad { display:block; width:100%; height:150px; touch-action:none; cursor:crosshair; border-radius:var(--radius-sm); }
  .pad-wrap.invalid { border-style:solid; border-color:var(--warn); }
  .pad-tools { display:flex; justify-content:space-between; align-items:center; font-size:13px; color:var(--text-muted); }
  .agree { display:flex; gap:10px; align-items:flex-start; font-size:14px; margin:12px 0 4px; color:var(--text-dim); }
  .agree input { accent-color:var(--accent-2); margin-top:3px; width:18px; height:18px; flex:0 0 auto; }
  .signed-stamp { display:none; margin-top:10px; font-size:13px; color:var(--accent-2); font-weight:500; }
  .sig.done .signed-stamp { display:block; }
  .sig.done .pad-wrap { border-style:solid; border-color:var(--accent-2); }

  .actions { display:flex; flex-wrap:wrap; gap:10px; margin-top:22px; align-items:center; }
  .msg { font-size:14px; margin-top:12px; min-height:1.4em; color:var(--text-dim); }
  .msg.err { color:var(--warn); } .msg.ok { color:var(--accent-2); }
  .audit { display:none; margin-top:18px; font-size:13px; color:var(--text-muted); border-top:1px solid var(--border); padding-top:12px; word-break:break-all; }
  body.locked .audit { display:block; }
  body.locked #doc input, body.locked #doc textarea, body.locked #doc select { background:var(--bg); }
  body.locked .opts label, body.locked .agree { pointer-events:none; }
  .print-val { display:none; white-space:pre-wrap; color:var(--text); }
  .print-only { display:none; }

  @media print {
    /* Redefine the site's dark-theme tokens for print only — every rule above that uses
       these variables becomes print-safe (dark text on white) without needing a parallel
       set of print-specific overrides for each one. */
    :root {
      --bg:#fff; --bg-elev:#fff; --bg-card:#fff;
      --text:#1D2733; --text-dim:#5A6B7B; --text-muted:#5A6B7B;
      --border:#CCD4DD; --border-strong:#CCD4DD;
      --accent:#1F3A5F; --accent-2:#1F6F5C; --accent-text:#1F3A5F; --accent-soft:transparent;
    }
    @page { size:A4; margin:16mm 14mm; }
    body { background:#fff !important; font-size:11pt; }
    .site-header, .site-footer, nav.steps, .actions, .pad-tools .btn, .no-print, .msg { display:none !important; }
    .agreement-hero { border-bottom:2px solid var(--accent); padding:0 0 8px; }
    .agreement-hero .lede, .agreement-hero .crumbs { display:none !important; }
    #doc { padding:0; max-width:none; }
    section.sheet { border:0; padding:0; margin:0 0 10mm; border-radius:0; background:none; }
    section.break { break-before:page; }
    h3, .terms h4, .sig { break-after:avoid; break-inside:avoid; }
    #doc textarea { display:none !important; }
    .print-val { display:block; border:1px solid var(--border); border-radius:4px; padding:6px 8px; margin-top:4px; min-height:1.6em; }
    #doc input, #doc select { border:0 !important; border-bottom:1px solid var(--border) !important; border-radius:0 !important; padding:2px 0 !important; background:none !important; }
    .opts label { border:0; padding:2px 8px 2px 0; background:none; }
    .opts label:not(:has(input:checked)) { display:none; }
    canvas.pad { display:none; }
    .print-only { display:block; }
    img.sig-img { width:100%; height:auto; max-height:120px; object-fit:contain; }
    .audit { display:block; }
    .grid { gap:6px 14px; }
    ::placeholder { color:transparent; }
    input.empty { color:transparent !important; }
    img.sig-img:not([src]) { display:none; }
    .sig:not(.done) .agree { display:none; }
    .sig[hidden] { display:none !important; }
  }
</style>

<section class="detail-hero agreement-hero">
  <div class="container">
    <p class="crumbs"><a href="/">Home</a> &nbsp;/&nbsp; Website brief &amp; agreement</p>
    <p class="print-only" style="font-size:13px;color:var(--text-muted);margin:0 0 6px;">TelaLoom · telaloom.com</p>
    <h1>Website brief and design agreement</h1>
    <p class="lede">Tell us about your business and what you need, check the project details and terms, then sign on screen. You can print or save a PDF copy at any time.</p>
  </div>
</section>

<nav class="steps" aria-label="Sections">
  <div class="steps-inner">
    <a href="#details"><b>1</b>Your details</a>
    <a href="#brief"><b>2</b>Website brief</a>
    <a href="#project"><b>3</b>Project and fees</a>
    <a href="#terms"><b>4</b>Terms</a>
    <a href="#sign"><b>5</b>Sign</a>
    <span class="spacer"></span>
    <button class="btn btn-ghost small" type="button" data-print>Print or save PDF</button>
  </div>
</nav>

<main id="doc">

<!-- 1. PARTIES -->
<section class="sheet" id="details">
  <h2>Your details</h2>
  <p class="sub">The parties to this agreement.</p>

  <h3>Service provider</h3>
  <div class="grid">
    <label class="f">Name<input type="text" name="provider_name" value="Andrew [surname]"></label>
    <label class="f">Trading as<input type="text" name="provider_trading" value="TelaLoom"></label>
    <label class="f">ABN<input type="text" name="provider_abn" value=""></label>
    <label class="f">Email<input type="email" name="provider_email" value=""></label>
  </div>

  <h3>Client</h3>
  <div class="grid">
    <label class="f">Full name <span class="req">*</span><input type="text" name="client_name" required autocomplete="name"></label>
    <label class="f">Business name <span class="req">*</span><input type="text" name="client_business" required autocomplete="organization"></label>
    <label class="f">ABN<input type="text" name="client_abn" inputmode="numeric"></label>
    <label class="f">Phone<input type="tel" name="client_phone" autocomplete="tel"></label>
    <label class="f">Email <span class="req">*</span><input type="email" name="client_email" required autocomplete="email"></label>
    <label class="f">Business address<input type="text" name="client_address" autocomplete="street-address"></label>
  </div>
</section>

<!-- 2. BRIEF -->
<section class="sheet break" id="brief">
  <h2>Website brief</h2>
  <p class="sub">Schedule 2. Answer what you can; skip anything you're unsure about and we'll cover it together.</p>

  <h3>Your business</h3>
  <div class="grid">
    <label class="f full">What does your business do?<textarea name="business_description"></textarea></label>
    <label class="f full">Who are your customers?<textarea name="target_audience"></textarea></label>
    <label class="f">Area you serve <span class="hint">(e.g. Central Coast, Australia-wide)</span><input type="text" name="service_area"></label>
    <label class="f">Competitors or similar businesses<input type="text" name="competitors"></label>
  </div>

  <h3>Goals</h3>
  <fieldset><legend>What should the website do? <span class="hint">Tick all that apply</span></legend>
    <div class="opts" data-group="goals"></div></fieldset>
  <div class="grid" style="margin-top:14px">
    <label class="f full">What would make this site a success in six months?<textarea name="success"></textarea></label>
  </div>

  <h3>What you have now</h3>
  <div class="grid">
    <label class="f">Current website <span class="hint">(if any)</span><input type="url" name="current_site" placeholder="https://"></label>
    <label class="f">Domain name<input type="text" name="domain_name" placeholder="yourbusiness.com.au"></label>
  </div>
  <fieldset style="margin-top:14px"><legend>Domain</legend><div class="opts" data-group="domain_status" data-type="radio"></div></fieldset>
  <!-- If domain_status = "I need one": run the domain-checker skill (prior-use/spam/crypto-scam/blacklist/handle/trademark) before registering. Bundled free into builds, no separate line item. -->
  <p class="hint" style="margin-top:6px">If you need a new domain, we'll check it's clean &mdash; no prior spam, scam, or blacklist history &mdash; before we register it. No extra cost.</p>
  <fieldset style="margin-top:14px"><legend>Logo and branding</legend><div class="opts" data-group="logo" data-type="radio"></div></fieldset>

  <h3>Look and feel</h3>
  <fieldset><legend>Style</legend><div class="opts" data-group="style"></div></fieldset>
  <div class="grid" style="margin-top:14px">
    <label class="f full">Brand colours or fonts<input type="text" name="brand_colours"></label>
    <label class="f full">Websites you like, and what you like about them<textarea name="sites_liked"></textarea></label>
    <label class="f full">Websites or styles you don't want<textarea name="sites_disliked"></textarea></label>
  </div>

  <h3>Pages</h3>
  <fieldset><legend>Which pages do you need?</legend><div class="opts" data-group="pages"></div></fieldset>
  <div class="grid" style="margin-top:14px"><label class="f full">Other pages<input type="text" name="pages_other"></label></div>

  <h3>Features</h3>
  <fieldset><legend>What should the site be able to do?</legend><div class="opts" data-group="features"></div></fieldset>
  <div class="grid" style="margin-top:14px">
    <label class="f">Number of products <span class="hint">(if selling online)</span><input type="text" name="product_count"></label>
    <label class="f">Tools it needs to connect to <span class="hint">(e.g. Xero, Square, Mailchimp)</span><input type="text" name="integrations"></label>
  </div>

  <h3>Content</h3>
  <fieldset><legend>Written content</legend><div class="opts" data-group="copy" data-type="radio"></div></fieldset>
  <fieldset style="margin-top:14px"><legend>Photos</legend><div class="opts" data-group="photos" data-type="radio"></div></fieldset>
  <div class="grid" style="margin-top:14px"><label class="f">Content ready by<input type="date" name="content_ready"></label></div>

  <h3>After launch</h3>
  <fieldset><legend>Who will update the site?</legend><div class="opts" data-group="updates" data-type="radio"></div></fieldset>
  <fieldset style="margin-top:14px"><legend>Ongoing help you're interested in</legend><div class="opts" data-group="ongoing"></div></fieldset>

  <h3>Budget and timing</h3>
  <div class="grid">
    <label class="f">Budget
      <select name="budget"><option value="">Select</option><option>Under $1,500</option><option>$1,500 – $3,000</option><option>$3,000 – $6,000</option><option>$6,000 – $10,000</option><option>Over $10,000</option><option>Not sure yet</option></select></label>
    <label class="f">Ideal launch date<input type="date" name="deadline"></label>
    <label class="f full">Is that date tied to anything? <span class="hint">(event, season, campaign)</span><input type="text" name="deadline_reason"></label>
    <label class="f full">Anything else we should know?<textarea name="notes"></textarea></label>
  </div>
</section>

<!-- 3. PROJECT (Schedule 1) -->
<section class="sheet break" id="project">
  <h2>Project and fees</h2>
  <p class="sub">Schedule 1. Completed by TelaLoom after reviewing your brief.</p>
  <div class="grid">
    <label class="f full">Project name<input type="text" name="project_name"></label>
    <label class="f full">Scope<textarea name="scope"></textarea></label>
    <label class="f full">Pages included<textarea name="pages_agreed"></textarea></label>
    <label class="f full">Features included<textarea name="features_agreed"></textarea></label>
    <label class="f full">Not included<textarea name="exclusions"></textarea></label>
    <label class="f">Start date<input type="date" name="start_date"></label>
    <label class="f">Target launch<input type="date" name="launch_date"></label>
  </div>

  <h3>Fees</h3>
  <div class="grid">
    <label class="f">Total project fee<input type="text" name="total_fee" placeholder="$"></label>
    <label class="f">Extra work rate<input type="text" name="hourly_rate" placeholder="$ per hour"></label>
  </div>
  <fieldset style="margin-top:14px"><legend>GST</legend><div class="opts" data-group="gst" data-type="radio"></div></fieldset>
  <p class="note" style="margin-top:14px">Payment: 50% deposit on signing (non-refundable), work starts once received. 50% balance on completion, before the site goes live. Two rounds of revisions included per stage (design, then build).</p>

  <h3>Ongoing services <span class="hint" style="font-weight:400;color:var(--text-muted)">(optional)</span></h3>
  <div class="grid">
    <label class="f">Monthly fee<input type="text" name="monthly_fee" placeholder="$ per month, or N/A"></label>
    <label class="f">Includes<input type="text" name="monthly_scope" placeholder="e.g. hosting, updates, backups, SEO"></label>
  </div>
  <p class="note" style="margin-top:14px">Month to month. Either party can cancel with 30 days' written notice.</p>
</section>

<!-- 4. TERMS -->
<section class="sheet break terms" id="terms">
  <h2>Terms</h2>
  <p class="sub">The terms that apply to this project.</p>

  <h4>1. Scope of work</h4>
  <p><b>1.1</b>The Provider will design and build the website described in Schedule 1 (the Project), informed by the Client's Website Brief in Schedule 2. If the two conflict, Schedule 1 prevails.</p>
  <p><b>1.2</b>Anything not listed in Schedule 1 is out of scope and will be quoted separately. Out-of-scope work only starts once the Client approves the quote in writing (email is fine).</p>

  <h4>2. Client responsibilities</h4>
  <p><b>2.1</b>The Client will supply all text, images, logos, product details and logins needed for the Project in a timely manner.</p>
  <p><b>2.2</b>The Client will provide feedback and approvals within five (5) business days of each request.</p>
  <p><b>2.3</b>The Client is responsible for the accuracy and legality of all content it supplies, including any claims about its products or services, and indemnifies the Provider against any claim, loss or cost arising from that content.</p>

  <h4>3. Fees and payment</h4>
  <p><b>3.1</b>The Client will pay the fees in Schedule 1. Invoices are payable within seven (7) days.</p>
  <p><b>3.2</b>The deposit is required before work starts. The website will not be launched or transferred until the balance is paid in full.</p>
  <p><b>3.3</b>If an invoice is more than 14 days overdue, the Provider may pause work, or suspend any hosting or ongoing services it manages, until payment is received.</p>
  <p><b>3.4</b>Third-party costs (domains, hosting, premium plugins, themes, stock images, paid apps) are not included unless stated in Schedule 1 and are paid by the Client.</p>

  <h4>4. Revisions and changes</h4>
  <p><b>4.1</b>A revision round is a single consolidated list of changes supplied at one time. Schedule 1 sets out how many are included.</p>
  <p><b>4.2</b>Additional revisions, or changes to approved work, are charged at the extra work rate in Schedule 1.</p>

  <h4>5. Timeline and delays</h4>
  <p><b>5.1</b>Dates in Schedule 1 are estimates and depend on the Client meeting its responsibilities under clause 2.</p>
  <p><b>5.2</b>If the Client delays supplying content or feedback, the timeline extends accordingly.</p>
  <p><b>5.3</b>If the Project stalls for more than 30 days because of the Client, the Provider may invoice for work completed to date and place the Project on hold. Restarting may need rescheduling.</p>

  <h4>6. Approval and launch</h4>
  <p><b>6.1</b>When the website is ready, the Provider will ask the Client for a final review. The Client has five (5) business days to report issues against the agreed scope.</p>
  <p><b>6.2</b>If no issues are reported in that time, or the Client starts using the website publicly, the website is taken to be approved.</p>

  <h4>7. Domains, hosting and third-party services</h4>
  <p><b>7.1</b>Domain names should be registered in the Client's name. Anything the Provider registers on the Client's behalf will be transferred to the Client on request once all fees are paid.</p>
  <p><b>7.2</b>The Provider is not responsible for outages, price or policy changes, or data loss caused by third-party providers (e.g. domain registrars, payment gateways, or platforms such as Shopify or WordPress.com). Where the Provider hosts the website on its own infrastructure, no specific uptime is guaranteed; the Provider will use reasonable efforts to maintain availability and restore service promptly after any outage.</p>

  <h4>8. Intellectual property</h4>
  <p><b>8.1</b>Once all fees are paid, the Client owns the final website design and content created specifically for the Client under this Agreement.</p>
  <p><b>8.2</b>The Provider keeps ownership of its pre-existing tools, code, templates and know-how, and grants the Client a permanent, non-exclusive licence to use them as part of the website.</p>
  <p><b>8.3</b>Third-party items (fonts, themes, plugins, stock images) remain subject to their own licences.</p>
  <p><b>8.4</b>Unless the Client objects in writing, the Provider may show the completed website in its portfolio and include a small credit link in the footer.</p>

  <h4>9. Warranty and support</h4>
  <p><b>9.1</b>The Provider will fix any defect in its own work reported within 30 days of launch, at no charge.</p>
  <p><b>9.2</b>This does not cover problems caused by changes made by the Client or others, third-party updates, or new feature requests, which are charged at the extra work rate.</p>

  <h4>10. Liability</h4>
  <p><b>10.1</b>Nothing in this Agreement excludes, restricts or modifies any right or remedy the Client has under the Australian Consumer Law that cannot lawfully be excluded.</p>
  <p><b>10.2</b>To the extent permitted by law, the Provider's total liability is limited to the fees paid for the Project, and the Provider is not liable for indirect or consequential loss, including lost profits, revenue or data.</p>
  <p><b>10.3</b>The Client is responsible for keeping backups of its own content and for complying with laws that apply to its business and website, including privacy, spam and consumer law.</p>

  <h4>11. Confidentiality and privacy</h4>
  <p><b>11.1</b>Each party will keep the other's confidential information private and use it only for this Project.</p>
  <p><b>11.2</b>Logins supplied to the Provider will be stored securely and used only to do the work. The Client should change passwords once the Project is complete.</p>

  <h4>12. Termination</h4>
  <p><b>12.1</b>Either party may end this Agreement with 14 days' written notice.</p>
  <p><b>12.2</b>Either party may end it immediately if the other seriously breaches it and does not fix the breach within 7 days of being notified.</p>
  <p><b>12.3</b>The deposit is non-refundable. On termination, the Client pays for work completed to date and any third-party costs already incurred, less the deposit already paid; no part of the deposit itself is refunded regardless of how much work has been completed.</p>
  <p><b>12.4</b>Ownership under clause 8.1 transfers only for work that has been paid for.</p>

  <h4>13. General</h4>
  <p><b>13.1</b>The Provider is an independent contractor, not an employee, partner or agent of the Client.</p>
  <p><b>13.2</b>This Agreement, including Schedules 1 and 2, is the entire agreement between the parties. Changes must be agreed in writing; email is sufficient.</p>
  <p><b>13.3</b>If a dispute arises, the parties will first try to resolve it in good faith. If it isn't resolved within 21 days, either party may refer it to mediation before starting court proceedings.</p>
  <p><b>13.4</b>This Agreement is governed by the laws of New South Wales, Australia.</p>
  <p><b>13.5</b>Each party consents to signing this Agreement electronically. It may be signed in counterparts.</p>
  <p><b>13.6</b>Neither party is liable for delay or failure to perform caused by circumstances beyond its reasonable control, including illness, injury, internet or utility outages, or failures of third-party platforms. The affected party will notify the other as soon as practicable and resume performance once the circumstance ends.</p>
</section>

<!-- 5. SIGN -->
<section class="sheet break" id="sign">
  <h2>Sign</h2>
  <p class="sub" id="sign-sub">Type your name, sign in the box with your finger or mouse, and tick to agree.</p>

  <div class="sigs">
    <div class="sig" data-party="client">
      <h4>Client</h4>
      <label class="f">Full name <span class="req">*</span><input type="text" name="client_sign_name" required></label>
      <label class="f" style="margin-top:10px">Position<input type="text" name="client_sign_role" placeholder="e.g. Owner, Director"></label>
      <div class="pad-wrap"><canvas class="pad" aria-label="Client signature pad" tabindex="0"></canvas></div>
      <div class="pad-tools"><span>Sign above the line</span><button type="button" class="btn btn-ghost small" data-clear>Clear</button></div>
      <label class="agree"><input type="checkbox" name="client_agree"> <span>I have read and agree to this Agreement, including the Website Brief and Project details, and I'm authorised to sign for the business.</span></label>
      <div class="signed-stamp"></div>
    </div>

    <div class="sig" data-party="provider" id="providerSig" hidden>
      <h4>Provider, TelaLoom</h4>
      <label class="f">Full name<input type="text" name="provider_sign_name"></label>
      <label class="f" style="margin-top:10px">Position<input type="text" name="provider_sign_role" value="Sole trader"></label>
      <div class="pad-wrap"><canvas class="pad" aria-label="Provider signature pad" tabindex="0"></canvas></div>
      <div class="pad-tools"><span>Sign above the line</span><button type="button" class="btn btn-ghost small" data-clear>Clear</button></div>
      <label class="agree"><input type="checkbox" name="provider_agree"> <span>I agree to this Agreement on behalf of TelaLoom.</span></label>
      <div class="signed-stamp"></div>
    </div>
  </div>

  <div class="actions">
    <button type="button" class="btn btn-primary" id="signBtn">Sign agreement</button>
    <button type="button" class="btn btn-ghost" data-print>Print or save PDF</button>
    <button type="button" class="btn btn-ghost no-print" id="counterBtn" hidden>Countersign as TelaLoom</button>
    <button type="button" class="btn btn-ghost no-print" id="sendBtn" hidden>Send signed copy</button>
  </div>
  <div class="msg" id="msg" role="status" aria-live="polite"></div>
  <div class="audit" id="audit"></div>
</section>

</main>

<script>
const WEBHOOK_URL = 'https://n8n.telaloom.com/webhook/agreement-signed';

const GROUPS = {
  goals: ['Get enquiries or leads','Take bookings','Sell products online','Show our work','Share information','Build trust'],
  domain_status: ['I own one','I need one','Not sure'],
  logo: ['Ready to use','Needs a refresh','Need one made'],
  style: ['Clean and minimal','Bold','Warm and friendly','Premium','Traditional','Playful'],
  pages: ['Home','About','Services','Shop','Gallery or portfolio','Testimonials','Blog or news','FAQ','Team','Contact','Booking'],
  features: ['Contact form','Online booking','Online payments','Online shop','Newsletter sign-up','Google Map','Social media links','Reviews','Live chat','Member login','Multiple languages','Blog'],
  copy: ["I'll supply all text",'I need help writing it','A mix of both'],
  photos: ['I have my own','Use stock photos','Need a photographer'],
  updates: ["I'll update it myself",'TelaLoom manages updates','Not sure'],
  ongoing: ['Hosting and maintenance','SEO and Google ranking','Monthly reporting'],
  gst: ['Includes GST','No GST (provider not registered)'],
};

// Build option groups
document.querySelectorAll('.opts[data-group]').forEach(box => {
  const g = box.dataset.group, type = box.dataset.type || 'checkbox';
  GROUPS[g].forEach(v => {
    const l = document.createElement('label');
    l.innerHTML = `<input type="${type}" name="${g}" value="${v.replace(/"/g,'&quot;')}"> <span></span>`;
    l.querySelector('span').textContent = v;
    box.appendChild(l);
  });
});

const doc = document.getElementById('doc');
const fields = () => [...doc.querySelectorAll('input[name],textarea[name],select[name]')];

// Prefill from query string
const qs = new URLSearchParams(location.search);
qs.forEach((val, key) => {
  const els = doc.querySelectorAll(`[name="${CSS.escape(key)}"]`);
  if (!els.length) return;
  if (els[0].type === 'checkbox' || els[0].type === 'radio') {
    const vals = val.split(',').map(s => s.trim().toLowerCase());
    els.forEach(e => { e.checked = vals.includes(e.value.toLowerCase()); });
  } else els[0].value = val;
});
if (qs.get('lock') === 'project') {
  document.querySelectorAll('#project input, #project textarea').forEach(e => {
    if (e.type === 'radio') e.closest('label').style.pointerEvents = 'none'; else e.readOnly = true;
  });
}
// Provider countersignature is only ever offered on a link TelaLoom opens itself
// (emailed by the webhook after the client signs) — never exposed in the client's own
// signing session, so a client can't complete both signatures themselves. On that link,
// the client's own sign box has nothing to do here either, so it's swapped out entirely
// for the provider's — this is a review/countersign page, not a dual-signing page.
const allowCountersign = qs.get('countersign') === '1';
const clientSigBox = document.querySelector('.sig[data-party="client"]');
const providerSigBox = document.getElementById('providerSig');
if (allowCountersign) {
  clientSigBox.hidden = true;
  providerSigBox.hidden = false;
  document.getElementById('signBtn').hidden = true;
  document.getElementById('counterBtn').hidden = false;
  document.getElementById('sign-sub').textContent = 'Review the details above, then sign in the box below to countersign on behalf of TelaLoom.';
}

// Mirror textareas for print
document.querySelectorAll('textarea').forEach(t => {
  const d = document.createElement('div'); d.className = 'print-val';
  t.after(d);
  const sync = () => { d.textContent = t.value; };
  t.addEventListener('input', sync); sync();
});

// Signature pads
const pads = new Map();
document.querySelectorAll('.sig').forEach(sig => {
  const c = sig.querySelector('canvas'), ctx = c.getContext('2d');
  const state = { drawn: false, img: null };
  const size = () => {
    const snap = state.drawn ? c.toDataURL() : null;
    const r = c.getBoundingClientRect(), dpr = window.devicePixelRatio || 1;
    c.width = r.width * dpr; c.height = r.height * dpr;
    ctx.setTransform(dpr,0,0,dpr,0,0);
    ctx.lineWidth = 2.2; ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.strokeStyle = '#1A3D8F';
    if (snap) { const i = new Image(); i.onload = () => ctx.drawImage(i,0,0,r.width,r.height); i.src = snap; }
  };
  size(); window.addEventListener('resize', size);
  let down = false, last = null;
  const pt = e => { const r = c.getBoundingClientRect(); return { x:e.clientX - r.left, y:e.clientY - r.top }; };
  c.addEventListener('pointerdown', e => { if (sig.classList.contains('done')) return; down = true; last = pt(e); c.setPointerCapture(e.pointerId); ctx.beginPath(); ctx.arc(last.x,last.y,1,0,Math.PI*2); ctx.fillStyle='#1A3D8F'; ctx.fill(); state.drawn = true; sig.querySelector('.pad-wrap').classList.remove('invalid'); });
  c.addEventListener('pointermove', e => { if (!down) return; const p = pt(e); ctx.beginPath(); ctx.moveTo(last.x,last.y); ctx.lineTo(p.x,p.y); ctx.stroke(); last = p; });
  ['pointerup','pointercancel','pointerleave'].forEach(ev => c.addEventListener(ev, () => { down = false; }));
  sig.querySelector('[data-clear]').addEventListener('click', () => {
    if (sig.classList.contains('done')) return;
    ctx.clearRect(0,0,c.width,c.height); state.drawn = false;
  });
  // print image
  const img = document.createElement('img'); img.className = 'sig-img print-only'; img.alt = 'Signature';
  sig.querySelector('.pad-wrap').appendChild(img);
  state.img = img;
  pads.set(sig.dataset.party, { sig, c, state });
});
if (allowCountersign) { const p = pads.get('provider'); /* box just became visible — canvas needs its real size now */ const r = p.c.getBoundingClientRect(); }

const refreshPrintImages = () => {
  pads.forEach(({ c, state }) => { if (state.drawn) state.img.src = c.toDataURL('image/png'); else state.img.removeAttribute('src'); });
  doc.querySelectorAll('input').forEach(e => e.classList.toggle('empty', !e.value && e.type !== 'checkbox' && e.type !== 'radio'));
};
window.addEventListener('beforeprint', refreshPrintImages);
document.querySelectorAll('[data-print]').forEach(b => b.addEventListener('click', () => { refreshPrintImages(); window.print(); }));

// Collect data
function collect() {
  const out = {};
  fields().forEach(e => {
    if (e.type === 'checkbox' && GROUPS[e.name]) { (out[e.name] ||= []); if (e.checked) out[e.name].push(e.value); }
    else if (e.type === 'radio') { if (e.checked) out[e.name] = e.value; else out[e.name] ??= ''; }
    else if (e.type === 'checkbox') out[e.name] = e.checked;
    else out[e.name] = e.value.trim();
  });
  return out;
}
async function sha256(str) {
  try {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(str));
    return [...new Uint8Array(buf)].map(b => b.toString(16).padStart(2,'0')).join('');
  } catch { return 'unavailable'; }
}

const msg = document.getElementById('msg');
const say = (t, cls) => { msg.textContent = t; msg.className = 'msg ' + (cls || ''); };
let signedRecord = null;

document.getElementById('signBtn').addEventListener('click', async () => {
  doc.querySelectorAll('.invalid').forEach(e => e.classList.remove('invalid'));
  const missing = [];
  doc.querySelectorAll('[required]').forEach(e => { if (!e.value.trim()) { e.classList.add('invalid'); missing.push(e); } });
  const email = doc.querySelector('[name=client_email]');
  if (email.value && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email.value)) { email.classList.add('invalid'); missing.push(email); }
  const cp = pads.get('client');
  if (!cp.state.drawn) { cp.sig.querySelector('.pad-wrap').classList.add('invalid'); missing.push(cp.c); }
  const agree = doc.querySelector('[name=client_agree]');
  if (!agree.checked) { agree.closest('.agree').classList.add('invalid'); missing.push(agree); }
  if (missing.length) { say('Some required items are missing. They are outlined in red.', 'err'); missing[0].focus(); return; }

  const now = new Date();
  const stamp = now.toLocaleString('en-AU', { dateStyle:'long', timeStyle:'short' }) + ' (' + Intl.DateTimeFormat().resolvedOptions().timeZone + ')';
  const data = collect();
  const hash = await sha256(JSON.stringify(data));
  const ymd = now.getFullYear() + String(now.getMonth()+1).padStart(2,'0') + String(now.getDate()).padStart(2,'0');
  const ref = 'DT-' + ymd + '-' + hash.slice(0,6).toUpperCase();

  cp.sig.classList.add('done');
  cp.sig.querySelector('.signed-stamp').textContent = `Signed electronically by ${data.client_sign_name}, ${stamp}`;

  fields().forEach(e => { if (e.type !== 'checkbox' && e.type !== 'radio') e.readOnly = true; });
  document.body.classList.add('locked');
  refreshPrintImages();

  document.getElementById('audit').innerHTML =
    `<strong>Reference ${ref}</strong><br>Signed ${now.toISOString()}<br>Content fingerprint (SHA-256): ${hash}` +
    '<br>Awaiting countersignature by TelaLoom.';

  signedRecord = {
    reference: ref, signed_at: now.toISOString(), timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
    sha256: hash, user_agent: navigator.userAgent, page: location.href.split('?')[0],
    status: 'client_signed',
    fields: data,
    signatures: { client: cp.c.toDataURL('image/png'), provider: null },
  };
  document.getElementById('signBtn').hidden = true;
  if (WEBHOOK_URL) {
    say('Signed. Sending your copy to TelaLoom…');
    await sendRecord();
  } else {
    say('Signed. Save a PDF using Print, and email it to TelaLoom.', 'ok');
  }
});

document.getElementById('counterBtn').addEventListener('click', async () => {
  const pv = pads.get('provider'), nameEl = doc.querySelector('[name=provider_sign_name]'), ag = doc.querySelector('[name=provider_agree]');
  pv.sig.querySelectorAll('.invalid').forEach(e => e.classList.remove('invalid'));
  let bad = false;
  if (!nameEl.value.trim()) { nameEl.classList.add('invalid'); bad = true; }
  if (!pv.state.drawn) { pv.sig.querySelector('.pad-wrap').classList.add('invalid'); bad = true; }
  if (!ag.checked) { ag.closest('.agree').classList.add('invalid'); bad = true; }
  if (bad) { say('Complete the provider name, signature and agreement tick to countersign.', 'err'); return; }
  const now = new Date();
  const stamp = now.toLocaleString('en-AU', { dateStyle:'long', timeStyle:'short' }) + ' (' + Intl.DateTimeFormat().resolvedOptions().timeZone + ')';
  pv.sig.classList.add('done');
  pv.sig.querySelector('.signed-stamp').textContent = `Signed electronically by ${nameEl.value.trim()}, ${stamp}`;
  pv.sig.querySelectorAll('input').forEach(e => { e.readOnly = true; }); ag.closest('.agree').style.pointerEvents = 'none';
  const audit = document.getElementById('audit');
  audit.innerHTML = audit.innerHTML.replace('Awaiting countersignature by TelaLoom.', 'Countersigned ' + now.toISOString());
  document.getElementById('counterBtn').hidden = true; refreshPrintImages();

  // Same-session case (client and provider signed in one sitting, e.g. together on a call):
  // the full record with the client's signature is already in memory — merge and resend it.
  let payload;
  if (signedRecord) {
    Object.assign(signedRecord.fields, { provider_sign_name: nameEl.value.trim(), provider_sign_role: doc.querySelector('[name=provider_sign_role]').value.trim(), provider_agree: true });
    signedRecord.signatures.provider = pv.c.toDataURL('image/png'); signedRecord.countersigned_at = now.toISOString();
    signedRecord.status = 'countersigned';
    payload = signedRecord;
  } else {
    // Remote case: this is a fresh session opened from the countersign link the webhook
    // emailed to TelaLoom (?countersign=1&ref=...). We never held the client's data
    // here, so send just the provider's part; the webhook merges it with the original
    // client-signed record it already has on file, keyed by reference.
    payload = {
      event: 'countersign_only', reference: qs.get('ref'), token: qs.get('token'), countersigned_at: now.toISOString(),
      timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
      provider_sign_name: nameEl.value.trim(), provider_sign_role: doc.querySelector('[name=provider_sign_role]').value.trim(),
      provider_signature: pv.c.toDataURL('image/png'),
    };
  }
  if (WEBHOOK_URL) { say('Countersigned. Sending the final copy to both parties…'); await sendRecord(payload); }
  else say('Countersigned. Save a PDF for both parties.', 'ok');
});

// Sends a record to the webhook automatically. Accepts either the full signedRecord
// (normal client-sign path, or same-session countersign) or a minimal
// {event:'countersign_only', reference, ...} payload (remote countersign path — see
// counterBtn handler above). The "Send signed copy" button stays hidden unless this
// fails, in which case it's shown as a manual retry of the same payload.
let lastPayload = null;
async function sendRecord(payload) {
  payload = payload || signedRecord;
  if (!payload || !WEBHOOK_URL) return;
  lastPayload = payload;
  const b = document.getElementById('sendBtn');
  const isCountersign = payload.status === 'countersigned' || payload.event === 'countersign_only';
  try {
    const r = await fetch(WEBHOOK_URL, { method:'POST', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify(payload) });
    if (!r.ok) throw new Error('HTTP ' + r.status);
    say(isCountersign ? 'Sent. Both parties now have a copy of the fully signed agreement.'
                       : 'Sent. TelaLoom has your signed copy — save a PDF for your own records too.', 'ok');
    b.hidden = true; b.disabled = false;
  } catch (e) {
    b.hidden = false; b.disabled = false;
    say('Could not send automatically (' + e.message + '). Click "Send signed copy" to retry, or save a PDF with Print and email it.', 'err');
  }
}
document.getElementById('sendBtn').addEventListener('click', async () => {
  document.getElementById('sendBtn').disabled = true;
  say('Sending…');
  await sendRecord(lastPayload);
});

// Render mode: the n8n workflow fetches this page, injects a completed record as
// window.__PREFILL__, and sends the resulting HTML to Gotenberg (emulatedMediaType=print)
// to produce the canonical signed PDF. Reuses the exact same markup/terms/print CSS the
// client saw — no separate PDF template to keep in sync. Not used in the normal browser flow.
if (window.__PREFILL__) (async () => {
  // Whatever happens below, __PREFILL_DONE__ must end up set — Gotenberg polls
  // this expression and otherwise hangs until its own request timeout, which
  // is how a single bad signature image previously wedged every PDF render.
  try {
    const rec = window.__PREFILL__;
    // A render always needs both sig boxes visible regardless of how they were signed.
    clientSigBox.hidden = false; providerSigBox.hidden = false;
    Object.entries(rec.fields || {}).forEach(([name, val]) => {
      const els = doc.querySelectorAll(`[name="${CSS.escape(name)}"]`);
      if (!els.length) return;
      if (Array.isArray(val)) { const lc = val.map(v => String(v).toLowerCase()); els.forEach(e => { e.checked = lc.includes(e.value.toLowerCase()); }); }
      else if (els[0].type === 'checkbox') els[0].checked = !!val;
      else if (els[0].type === 'radio') els.forEach(e => { e.checked = e.value === val; });
      else els[0].value = val ?? '';
    });
    document.querySelectorAll('textarea').forEach(t => { if (t.nextElementSibling?.classList.contains('print-val')) t.nextElementSibling.textContent = t.value; });
    fields().forEach(e => { if (e.type !== 'checkbox' && e.type !== 'radio') e.readOnly = true; });
    document.body.classList.add('locked');

    for (const party of ['client', 'provider']) {
      const dataUrl = rec.signatures && rec.signatures[party];
      const p = pads.get(party);
      if (!dataUrl) continue;
      const ctx = p.c.getContext('2d');
      try {
        await new Promise((res, rej) => {
          const img = new Image();
          img.onload = () => { const r = p.c.getBoundingClientRect(); ctx.drawImage(img, 0, 0, r.width, r.height); p.state.drawn = true; res(); };
          img.onerror = () => rej(new Error(`signature image failed to decode for ${party}`));
          img.src = dataUrl;
        });
      } catch (e) {
        console.error(e);
      }
      p.sig.classList.add('done');
      const name = party === 'client' ? rec.fields.client_sign_name : rec.fields.provider_sign_name;
      const when = party === 'provider' && rec.countersigned_at ? rec.countersigned_at : rec.signed_at;
      p.sig.querySelector('.signed-stamp').textContent = `Signed electronically by ${name}, ${new Date(when).toLocaleString('en-AU', { dateStyle: 'long', timeStyle: 'short' })} (${rec.timezone || 'UTC'})`;
    }

    document.getElementById('audit').innerHTML =
      `<strong>Reference ${rec.reference}</strong><br>Signed ${rec.signed_at}<br>Content fingerprint (SHA-256): ${rec.sha256}` +
      (rec.countersigned_at ? `<br>Countersigned ${rec.countersigned_at}` : '<br>Awaiting countersignature by TelaLoom.');

    refreshPrintImages();
  } catch (e) {
    console.error('prefill render failed', e);
  } finally {
    window.__PREFILL_DONE__ = true;
  }
})();
</script>
</BaseLayout>
