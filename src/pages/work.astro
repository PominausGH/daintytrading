---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProductCounts } from '../data/products';

const counts = await getProductCounts();

const products = [
  ['BrightPath', 'brightpath'], ['Email Triage', 'emailtriage'], ['Email Cleanup', 'emailcleanup'],
  ['Subscription Incinerator', 'subscription'], ['Everyring.ai', 'missed-calls'], ['CV Matcher', 'cv-matcher'],
  ['BizPage Builder', 'bizpage-builder'], ['FocusShield', 'focusguard'], ['AutoArchive', 'autoarchive'],
  ['TimerForge', 'timerforge'], ['Ghost Writer', 'ghost-writer'], ['Meditation', 'meditation'],
  ['Nudgle', 'skeddy'], ['Marketing OS', 'marketing-os'], ['ChatVault', 'chatvault'],
  ['Tax Prep', 'tax-prep'], ['Second Brain', 'second-brain'], ['ConvoForge', 'convoforge'],
  ['Solar Loan Reconciler', 'solar-loan-reconciler'], ['Price Scout', 'price-scout'], ['Auto-Claude', 'auto-claude'],
  ['FakeCall', 'fakecall'], ['StoryPulse', 'storypulse'], ['Post Reel', 'postreel'],
  ['DevTodo', 'devtodo'], ['ChefForge', 'chefforge'], ['Yoga Platform', 'yoga-platform'],
  ['Billing API', 'billing-api'], ['Recipe API', 'recipe-api'], ['Screenshot to Text', 'screenshot-to-text'],
  ['Receipt Bridge', 'receipt-bridge'], ['Prompt Builder', 'prompt-builder'], ['Finance Tracker', 'finance-tracker'],
  ['Banking Alerts', 'banking-alerts'], ['Telegram Crypto Sentiment', 'telegram-crypto-sentiment'],
  ['ScreenShoot Cleaner', 'screenshot-cleaner'], ['ReceiptSnap AI', 'receiptsnap-ai'], ['WiseKeel', 'wisekeel'],
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'TelaLoom Product Portfolio',
    description: `${counts.total} products built and operated by TelaLoom — across live, in final testing, and in active development.`,
    numberOfItems: counts.total,
    itemListElement: products.map(([name, slug], i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://telaloom.com/projects/${slug}.html`,
      name,
    })),
  },
];
---
<BaseLayout
  title={`Our Work — ${counts.total} AI Products Built by TelaLoom`}
  description={`Browse all ${counts.total} AI products built and operated by TelaLoom — ${counts.live} live and paying, others in final testing or active development. Real stack, real build story, every project page.`}
  canonicalPath="/work.html"
  robots="index, follow, max-image-preview:large, max-snippet:-1"
  jsonLd={jsonLd}
>
  <main id="main">
    <section class="detail-hero">
      <div class="container">
        <div class="crumbs"><a href="/">Home</a> &nbsp;/&nbsp; Work</div>
        <h1>{counts.total} AI Products Built and Running</h1>
        <p class="lede">Each project is a real product, not a case study slide. {counts.live} are live and paying, the rest are in final testing or active development &mdash; every page below says which. Click any card to read the full build story.</p>
      </div>
    </section>

    <section id="client-work">
      <div class="container">
        <div class="section-head">
          <h2>Client work</h2>
          <p>Not our product &mdash; their business. Selected engagements where we&rsquo;re the outside build or SEO/GEO team.</p>
        </div>
        <div class="project-group">
          <div class="project-grid">
            <a class="project-card" href="/projects/edwards-kirby-lawyers.html">
              <span class="tag">Client · Legal</span>
              <h3>Edwards Kirby Lawyers</h3>
              <p>Full website rebuild for a Sydney insolvency and business law firm, plus a secure client portal &mdash; JWT + MFA, encrypted document storage, SEO/GEO built in from day one.</p>
              <span class="outcome-line">About to go live</span>
              <span class="arrow">Read the story →</span>
            </a>
            <a class="project-card" href="/projects/shuttersmith.html">
              <span class="tag">Client · SEO/GEO</span>
              <h3>Shuttersmith</h3>
              <p>The first client on our productised SEO + GEO service &mdash; technical audit, structured data, and generative-engine optimisation so the business is found by Google and by AI assistants.</p>
              <span class="outcome-line">405 real visits, majority via Google &middot; led to a second business</span>
              <span class="arrow">Read the story →</span>
            </a>
            <a class="project-card" href="/projects/shuttersmith-rebuild.html">
              <span class="tag">Client · Website build</span>
              <h3>Shuttersmith Rebuild</h3>
              <p>A full rebuild off WordPress and Elementor onto a static Astro build in a hardened Docker container &mdash; real migrated content, a first-party contact service, Lighthouse-verified performance and accessibility.</p>
              <span class="outcome-line">Perf 92-98 &middot; Accessibility/Best Practices/SEO 100 &middot; built, awaiting sign-off</span>
              <span class="arrow">Read the story →</span>
            </a>
            <a class="project-card" href="/projects/new-shutter-business.html">
              <span class="tag">Client · Home improvement</span>
              <h3>New Shutter Business</h3>
              <p>A second business, launched off the back of Shuttersmith&rsquo;s SEO/GEO results &mdash; trade-price plantation shutters with a self-install option and a full measure-and-quote build.</p>
              <span class="outcome-line">In staging, launching soon</span>
              <span class="arrow">Read the story →</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="projects">
      <div class="container">

        <div class="project-group">
          <h3 class="group-heading group-live">
            <span class="group-label"><span class="group-dot" aria-hidden="true"></span>Live</span>
            <span class="group-count">{counts.live} products</span>
          </h3>
          <div class="project-grid">
          <a class="project-card" href="/projects/brightpath.html"><span class="tag">AI · Education</span><h3>BrightPath</h3><p>Personalised K-12 online school with an AI tutor named Pax, gamified rewards, and progress tracking that actually nudges kids.</p><span class="outcome-line">AI tutor in production &middot; K&ndash;12 students on-platform daily</span><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/emailtriage.html"><span class="tag">AI · Productivity</span><h3>Email Triage</h3><p>Claude-powered email categorizer that scores priority, drafts replies, and runs across multiple Gmail and Outlook accounts.</p><span class="outcome-line">200+ emails processed daily &middot; Runs across Gmail &amp; Outlook</span><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/emailcleanup.html"><span class="tag">Tools · API</span><h3>Email Cleanup</h3><p>FastAPI service that validates email domains, flags disposable providers, and gives you a single endpoint for bulk list hygiene.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/subscription.html"><span class="tag">AI · Consumer</span><h3>Subscription Incinerator</h3><p>Finds the subscriptions you forgot, ranks them, and burns the ones you don&rsquo;t want. Claude drafts merchant-specific cancellation emails; SMS chases the rest.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/missed-calls.html"><span class="tag">AI · CRM</span><h3>Everyring.ai</h3><p>Captures missed phone calls, prioritises follow-ups, and uses Claude to draft the right next message for each contact &mdash; in seconds.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/cv-matcher.html"><span class="tag">AI · Careers</span><h3>CV Matcher</h3><p>Scrapes LinkedIn job postings, scores them against your CV with Claude, and tells you why each match scored the way it did.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/bizpage-builder.html"><span class="tag">AI · Local SEO</span><h3>BizPage Builder</h3><p>Discovers small businesses without websites, generates SEO-ready landing pages with Claude, and ships them as deployable ZIPs.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/focusguard.html"><span class="tag">Productivity · Mobile</span><h3>FocusShield</h3><p>Cross-platform focus and task app — web, iOS, Android — with productivity analytics and JWT auth wired into a Postgres backend.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/autoarchive.html"><span class="tag">Email · Automation</span><h3>AutoArchive</h3><p>Built for a Big 4 Australian bank. Backs up 45 shared email boxes four times a day to a secure local disk — each email named by message ID for instant retrieval, no database needed.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/timerforge.html"><span class="tag">SaaS · Cross-platform</span><h3>TimerForge</h3><p>Countdown timer that ships as a desktop app for Windows/Mac/Linux and a web SaaS — embeddable, shareable, billed by Stripe.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/ghost-writer.html"><span class="tag">AI · Content</span><h3>Ghost Writer</h3><p>End-to-end content engine: detects trending topics, writes 1,500-word articles, runs 6-layer quality checks, and auto-publishes to LinkedIn and Medium.</p><span class="outcome-line">3 articles/week published &middot; No human writer in the loop</span><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/convoforge.html"><span class="tag">AI · Coaching</span><h3>ConvoForge</h3><p>Multimodal AI communication coach. Speech analysis, body-language feedback, AI avatar roleplay, and a live meeting overlay.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/solar-loan-reconciler.html"><span class="tag">Finance · Automation</span><h3>Solar Loan Reconciler</h3><p>Built for a financial company. Collects Mon&ndash;Fri solar loan transaction CSVs, matches them against the weekly Loan Payout Report, flags any gaps, and emails a clean HTML report to the loans team every Friday.</p><span class="outcome-line">Zero missed loans since go-live &middot; Fully automated every Friday</span><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/skeddy.html"><span class="tag">AI · Bots</span><h3>Nudgle</h3><p>Telegram reminder bot with natural-language scheduling. Quiet hours, vacation mode, recurring tasks — all parsed by Claude.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/marketing-os.html"><span class="tag">AI · Marketing Ops</span><h3>Marketing OS</h3><p>The internal control tower for our marketing — cross-portfolio SEO/GEO audits, Search Console visibility, and per-product customer tracking, in one dashboard.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/postreel.html"><span class="tag">AI · Social media</span><h3>Post Reel</h3><p>Social media scheduler with an AI video studio built in. Give it a URL, it crawls the site, writes a script, synthesises a voiceover, and produces a finished short-form video — scheduled across 12 platforms automatically.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/billing-api.html"><span class="tag">Infrastructure · SaaS</span><h3>Billing API</h3><p>Shared billing service across our portfolio. Stripe, Brevo, Postgres, and a Fastify core that lets every product launch on day one with payments wired in.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/wisekeel.html"><span class="tag">AI · Agent Deployment</span><h3>WiseKeel</h3><p>Fixed-price AI agent deployment engagements, run inside a client&rsquo;s own infrastructure &mdash; scoped identity, human approval gates, full audit trail. No platform fee.</p><span class="arrow">Read the story →</span></a>
          </div>
        </div>

        <div class="project-group">
          <h3 class="group-heading group-test">
            <span class="group-label"><span class="group-dot" aria-hidden="true"></span>In final testing</span>
            <span class="group-count">{counts.testing} products</span>
          </h3>
          <div class="project-grid">
          <a class="project-card" href="/projects/second-brain.html"><span class="tag">AI · Knowledge <span class="badge-test">in test</span></span><h3>Second Brain</h3><p>Telegram-native note-taking. Forward anything &mdash; voice, photo, link, half-thought &mdash; and Claude tags it, links it, and gives it back when you actually need it.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/meditation.html"><span class="tag">Wellness · SaaS <span class="badge-test">in test</span></span><h3>Meditation</h3><p>Subscription meditation library with a 7-day free trial, Stripe billing, and a content gate that doesn&rsquo;t feel like a content gate.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/chatvault.html"><span class="tag">AI · Knowledge <span class="badge-test">in test</span></span><h3>ChatVault</h3><p>One searchable archive of every conversation across Claude, ChatGPT, Gemini, Grok, and Perplexity. Stop losing the answer you got three weeks ago in a different tab.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/tax-prep.html"><span class="tag">AI · Personal Finance <span class="badge-test">in test</span></span><h3>Tax Prep</h3><p>Drop receipts, statements, and slips in throughout the year. Claude classifies and tags. At year-end, one export gives your accountant a structured handover.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/price-scout.html"><span class="tag">AI · Cost-of-living <span class="badge-test">in test</span></span><h3>Price Scout</h3><p>Cost-of-living dashboard tracking grocery, fuel, and energy prices across Australia and the UK. Households see how their spend compares week to week.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/auto-claude.html"><span class="tag">AI · Developer Tools <span class="badge-test">in test</span></span><h3>Auto-Claude</h3><p>Autonomous multi-agent coding framework. Plans, builds, runs tests, and iterates until the goal is met &mdash; humans only when it asks.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/fakecall.html"><span class="tag">AI · Mobile <span class="badge-test">in test</span></span><h3>FakeCall</h3><p>Schedule a believable incoming call with an AI on the other end having a real conversation. CallKit on iOS, streaming Claude responses.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/storypulse.html"><span class="tag">AI · Marketing automation <span class="badge-test">in test</span></span><h3>StoryPulse</h3><p>Instagram growth-automation SaaS. Automated story views and reactions, AI captions, multi-account campaigns, anti-detection layer, Stripe-billed plans.</p><span class="arrow">Read the story →</span></a>
          </div>
        </div>

        <div class="project-group">
          <h3 class="group-heading group-dev">
            <span class="group-label"><span class="group-dot" aria-hidden="true"></span>In active development</span>
            <span class="group-count">{counts.dev} products</span>
          </h3>
          <div class="project-grid">
          <a class="project-card" href="/projects/devtodo.html"><span class="tag">AI · Developer Tools <span class="badge-dev">in dev</span></span><h3>DevTodo</h3><p>Pulls TODOs from your code, syncs Google Calendar, runs through n8n, and uses Claude to write the summary you would&rsquo;ve skipped.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/chefforge.html"><span class="tag">AI · Lifestyle <span class="badge-dev">in dev</span></span><h3>ChefForge</h3><p>AI recipe and meal planning service. Tell it your constraints, get a week of dinners and a shopping list that actually adds up.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/yoga-platform.html"><span class="tag">Wellness · Mobile <span class="badge-dev">in dev</span></span><h3>Yoga Platform</h3><p>500+ poses, sequence builder, mobile + web. Filter by chakra, prop, body part, or style — then save your flow.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/recipe-api.html"><span class="tag">API · Backend <span class="badge-dev">in dev</span></span><h3>Recipe API</h3><p>Django REST API for recipes and ingredients — filtering, pagination, auth, and a clean schema you can plug into any front-end.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/screenshot-to-text.html"><span class="tag">AI · OCR SaaS <span class="badge-dev">in dev</span></span><h3>Screenshot to Text</h3><p>Production OCR for tables, handwriting, and complex layouts. Tesseract for the easy text, GPT-4 Vision for the hard, Stripe for billing.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/receipt-bridge.html"><span class="tag">AI · Field operations <span class="badge-dev">in dev</span></span><h3>Receipt Bridge</h3><p>Field workers text a receipt photo to a shared number. OCR extracts the data, finance reviews in a dashboard. No paper, no manual entry.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/prompt-builder.html"><span class="tag">AI · Productivity <span class="badge-dev">in dev</span></span><h3>Prompt Builder</h3><p>A 3-step wizard that turns rough ideas into polished AI prompts. Adaptive clarifying questions per goal, not a fixed checklist.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/finance-tracker.html"><span class="tag">Personal finance <span class="badge-dev">in dev</span></span><h3>Finance Tracker</h3><p>No-frills personal finance tracker for income, expenses, and budgets. Manual entry, clean charts, no SaaS subscription.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/banking-alerts.html"><span class="tag">Fintech · Automation <span class="badge-dev">in dev</span></span><h3>Banking Alerts</h3><p>Push alerts when bank balances drop below thresholds. Open Banking via Basiq, n8n on top, ntfy for the notifications.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/telegram-crypto-sentiment.html"><span class="tag">AI · Crypto research <span class="badge-dev">in dev</span></span><h3>Telegram Crypto Sentiment</h3><p>Monitors crypto Telegram groups for sentiment, scores it with Claude, and correlates against price movement to surface predictive channels.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/screenshot-cleaner.html"><span class="tag">Productivity · Automation <span class="badge-dev">in dev</span></span><h3>ScreenShoot Cleaner</h3><p>Drop a folder of screenshots, get back a clean PDF. Auto-crop, deskew, contrast-normalise, sort, bundle. Local-first, no cloud.</p><span class="arrow">Read the story →</span></a>
          <a class="project-card" href="/projects/receiptsnap-ai.html"><span class="tag">AI · Mobile <span class="badge-dev">in dev</span></span><h3>ReceiptSnap AI</h3><p>Native iOS and Android receipt scanner. One-handed capture at the till, OCR via Google Cloud Vision, year-end export for your accountant.</p><span class="arrow">Read the story →</span></a>
          </div>
        </div>

      </div>
    </section>

    <section id="supporting-cast">
      <div class="container">
        <div class="section-head">
          <h2>Supporting cast</h2>
          <p>The open-source stack we self-host alongside our own builds. We don&rsquo;t bolt onto SaaS treadmills &mdash; we run the tools we recommend.</p>
        </div>

        <p class="cast-intro">
          The open-source stack we self-host. Each one replaces a SaaS, runs on our own boxes, and is something we can stand up for clients on day one.
        </p>

        <div class="project-group">
          <h3 class="group-heading group-live">
            <span class="group-label"><span class="group-dot" aria-hidden="true"></span>AI &amp; Automation</span>
            <span class="group-count">3 tools</span>
          </h3>
          <div class="project-grid">
            <a class="project-card" href="https://litellm.ai" target="_blank" rel="noopener"><span class="tag">Open source · vs provider keys</span><h3>LiteLLM Proxy</h3><p>Unified API gateway for LLM providers. One endpoint speaks Claude, OpenAI, Gemini, and others.</p><span class="arrow">Visit project →</span></a>
            <a class="project-card" href="https://openwebui.com" target="_blank" rel="noopener"><span class="tag">Open source · vs ChatGPT.com</span><h3>Open WebUI</h3><p>Self-hosted chat interface for any LLM. Pairs with Ollama or any OpenAI-compatible endpoint.</p><span class="arrow">Visit project →</span></a>
            <a class="project-card" href="https://n8n.io" target="_blank" rel="noopener"><span class="tag">Open source · vs Zapier</span><h3>n8n</h3><p>Visual workflow automation. Connects APIs, databases, and webhooks in versionable graphs.</p><span class="arrow">Visit project →</span></a>
          </div>
        </div>

        <div class="project-group">
          <h3 class="group-heading group-test">
            <span class="group-label"><span class="group-dot" aria-hidden="true"></span>Files &amp; Productivity</span>
            <span class="group-count">3 tools</span>
          </h3>
          <div class="project-grid">
            <a class="project-card" href="https://cal.com" target="_blank" rel="noopener"><span class="tag">Open source · vs Calendly</span><h3>Cal.com</h3><p>Open-source scheduling. Calendar-aware booking links, team rotations, and event types.</p><span class="arrow">Visit project →</span></a>
            <a class="project-card" href="https://docs.paperless-ngx.com" target="_blank" rel="noopener"><span class="tag">Open source · vs filing cabinets</span><h3>Paperless-NGX</h3><p>Document management for the paperless office. OCR, tagging, full-text search across PDFs and scans.</p><span class="arrow">Visit project →</span></a>
            <a class="project-card" href="https://syncthing.net" target="_blank" rel="noopener"><span class="tag">Open source · vs Dropbox</span><h3>Syncthing</h3><p>Peer-to-peer file synchronisation. Continuous sync between devices on your own network.</p><span class="arrow">Visit project →</span></a>
          </div>
        </div>

        <div class="project-group">
          <h3 class="group-heading group-dev">
            <span class="group-label"><span class="group-dot" aria-hidden="true"></span>Site &amp; Studio Ops</span>
            <span class="group-count">3 tools</span>
          </h3>
          <div class="project-grid">
            <a class="project-card" href="https://umami.is" target="_blank" rel="noopener"><span class="tag">Open source · vs Google Analytics</span><h3>Umami</h3><p>Privacy-friendly web analytics. Tracks page views, referrers, and user flows without cookies.</p><span class="arrow">Visit project →</span></a>
            <a class="project-card" href="https://speedtest-tracker.dev" target="_blank" rel="noopener"><span class="tag">Open source · vs tweeting at the ISP</span><h3>Speedtest Tracker</h3><p>Internet-speed monitor. Logs throughput on a schedule and triggers actions when it drops.</p><span class="arrow">Visit project →</span></a>
            <a class="project-card" href="https://portainer.io" target="_blank" rel="noopener"><span class="tag">Open source · vs ssh + docker ps</span><h3>Portainer</h3><p>Docker management UI. Visual control over containers, images, networks, and volumes across hosts.</p><span class="arrow">Visit project →</span></a>
          </div>
        </div>

        <div class="cast-philosophy">
          <p><strong>Why this matters for clients.</strong> When we build for you we&rsquo;re not stitching together SaaS subscriptions and hoping the prices don&rsquo;t change. We know what each of these tools costs, what they break under, and how they fail &mdash; because we run them ourselves. Same stack, your hardware, your auth.</p>
        </div>

        <div class="cta-banner">
          <h2>Have an AI idea you want shipped?</h2>
          <p>We pick a small number of client engagements each quarter. If you&rsquo;ve got something concrete, let&rsquo;s talk.</p>
          <a class="btn btn-primary" href="/contact.html">Start a project →</a>
        </div>
      </div>
    </section>

  </main>
  <script is:inline defer src="/js/shuttersmith-stats.js"></script>
</BaseLayout>
