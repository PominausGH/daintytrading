---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact TelaLoom',
    url: 'https://telaloom.com/contact.html',
    mainEntity: {
      '@type': 'Organization',
      name: 'TelaLoom',
      email: 'hello@telaloom.com',
      url: 'https://telaloom.com',
      contactPoint: [{
        '@type': 'ContactPoint',
        contactType: 'Project enquiries',
        email: 'hello@telaloom.com',
        availableLanguage: ['en'],
      }],
    },
  },
];
---
<BaseLayout
  title="Contact — TelaLoom | Start an AI Automation Project"
  description="Start an AI automation project with TelaLoom. Tell us what you want built and we'll reply within one business day with a scoped first sprint."
  canonicalPath="/contact.html"
  jsonLd={jsonLd}
>
  <style>
    .form-grid { display: grid; gap: 16px; max-width: 640px; }
    .form-grid label { display: block; font-size: 14px; color: var(--text-dim); margin-bottom: 6px; }
    .form-grid input, .form-grid textarea, .form-grid select {
      width: 100%; padding: 12px 14px; border-radius: 10px;
      background: var(--bg-elev); border: 1px solid var(--border); color: var(--text);
      font: inherit;
    }
    .form-grid input:focus, .form-grid textarea:focus, .form-grid select:focus {
      outline: none; border-color: var(--accent);
      box-shadow: 0 0 0 3px rgba(124,92,255,0.18);
    }
    .form-grid textarea { min-height: 160px; resize: vertical; }
    .form-grid button { justify-self: start; }
  </style>

  <main id="main">
    <section class="detail-hero">
      <div class="container">
        <div class="crumbs"><a href="/">Home</a> &nbsp;/&nbsp; Contact</div>
        <h1>Tell us what you want built.</h1>
        <p class="lede">Two paragraphs is enough. What&rsquo;s the workflow or product? What outcome would make it worth doing? We reply within one business day with a realistic scope &mdash; no pitch call required to get a straight answer.</p>
      </div>
    </section>

    <div class="container">
      <div class="detail-body">
        <article class="prose">
          <div id="contact-form-wrap">
            <form class="form-grid" id="contact-form" novalidate>
              <div>
                <label for="name">Your name</label>
                <input id="name" name="name" type="text" required autocomplete="name" />
              </div>
              <div>
                <label for="email">Email</label>
                <input id="email" name="email" type="email" required autocomplete="email" />
              </div>
              <div>
                <label for="company">Company (optional)</label>
                <input id="company" name="company" type="text" autocomplete="organization" />
              </div>
              <div>
                <label for="engagement">What kind of engagement?</label>
                <select id="engagement" name="engagement">
                  <option value="AI product build (concept → paying product)">AI product build (concept → paying product)</option>
                  <option value="Automation retrofit (add AI to my existing SaaS)">Automation retrofit (add AI to my existing SaaS)</option>
                  <option value="AI infrastructure (gateway, evals, billing, observability)">AI infrastructure (gateway, evals, billing, observability)</option>
                  <option value="SEO/GEO audit and fix">SEO/GEO audit and fix</option>
                  <option value="Local SEO/GEO (local service business)">Local SEO/GEO (local service business)</option>
                  <option value="Website build (new site for my business)">Website build (new site for my business)</option>
                  <option value="Something else">Something else</option>
                </select>
              </div>
              <div id="url-field-wrap" style="display:none;">
                <label for="url">Your website URL</label>
                <input id="url" name="url" type="url" placeholder="https://example.com" autocomplete="url" />
              </div>
              <div>
                <label for="timeline">What&rsquo;s your timeline?</label>
                <select id="timeline" name="timeline">
                  <option value="ASAP">ASAP — I want to move now</option>
                  <option value="1-3 months">1&ndash;3 months</option>
                  <option value="Just exploring">Just exploring for now</option>
                </select>
              </div>
              <div>
                <label for="budget">Rough budget, AUD (optional)</label>
                <select id="budget" name="budget">
                  <option value="">Prefer not to say</option>
                  <option value="Under $5k">Under $5k</option>
                  <option value="$5k-$10k">$5k&ndash;$10k</option>
                  <option value="$10k-$25k">$10k&ndash;$25k</option>
                  <option value="$25k-$50k">$25k&ndash;$50k</option>
                  <option value="$50k+">$50k+</option>
                </select>
              </div>
              <div>
                <label for="source">How did you hear about us? (optional)</label>
                <select id="source" name="source">
                  <option value="">Select one</option>
                  <option value="Google search">Google search</option>
                  <option value="AI assistant">AI assistant (ChatGPT, Perplexity, Gemini&hellip;)</option>
                  <option value="LinkedIn">LinkedIn</option>
                  <option value="Referral">Referral / word of mouth</option>
                  <option value="Other">Other</option>
                </select>
              </div>
              <div>
                <label for="message">What&rsquo;s the project?</label>
                <textarea id="message" name="message" required placeholder="One paragraph on the problem, one on what success looks like. That&rsquo;s all we need."></textarea>
              </div>

              <!-- Honeypot — invisible to humans; bots fill it in -->
              <div aria-hidden="true" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;">
                <label for="dt_website">Work phone</label>
                <input type="text" id="dt_website" name="dt_website" tabindex="-1" autocomplete="off" />
              </div>
              <input type="hidden" id="dt_form_loaded_at" name="dt_form_loaded_at" />

              <button type="submit" id="contact-submit" class="btn btn-primary">Send enquiry</button>
              <p id="form-error" class="muted" style="font-size:13px; margin:0; color:#f87171; display:none;"></p>
              <p class="muted" style="font-size:12px;margin:0;color:var(--text-muted);">&#128274; Your data is never sold or shared &middot; <a href="/privacy.html" style="color:var(--text-muted);text-decoration:underline;">Privacy policy</a></p>
              <p class="muted" style="font-size:13px; margin:0;">
                Once we&rsquo;ve read your brief we&rsquo;ll reach out &mdash; or <a href="https://cal.daintytrading.com/andrewdainty/telaloom" target="_blank" rel="noopener" data-umami-event="book_a_time_click" data-umami-event-source="contact_form">book a time directly</a> and pick a slot that suits you.
              </p>
              <p class="muted" style="font-size:13px; margin:0;">
                Phone: <button class="phone-reveal-btn" data-a="614" data-b="850" data-c="13007">show number</button>
              </p>
            </form>
          </div>

          <div id="contact-success" style="display:none; padding: 32px 0;">
            <h3 style="margin:0 0 12px;">Brief received.</h3>
            <p>We&rsquo;ll read it today and reply within one business day. In the meantime, you&rsquo;re welcome to <a href="https://cal.daintytrading.com/andrewdainty/telaloom" target="_blank" rel="noopener" data-umami-event="book_a_time_click" data-umami-event-source="contact_success">book a time directly</a> &mdash; pick a slot that suits you and we&rsquo;ll go over your project together.</p>
            <p class="muted" style="font-size:13px;">While you wait: <a href="/work.html">see the full portfolio &rarr;</a></p>
          </div>

          <script is:inline defer src="/js/contact-form.js"></script>

          <h2 style="margin-top:48px;">What happens next</h2>
          <ul>
            <li><strong>Within one business day</strong> &mdash; you&rsquo;ll get a written reply with our read on the project and any clarifying questions.</li>
            <li><strong>Within a week</strong> &mdash; if it&rsquo;s a fit, we send a one-page scope for the first sprint with a fixed price and a hard end date.</li>
            <li><strong>Within two weeks</strong> &mdash; first working slice, deployed somewhere you can use it.</li>
            <li><strong>From week three</strong> &mdash; we iterate with you: weekly demos, one feature per sprint, revising based on what you and real users see, until it&rsquo;s a product you can rely on. Typically paying customers by week eight, or we&rsquo;ll tell you why not.</li>
          </ul>
        </article>

        <aside class="sidecard">
          <h4>Direct contact</h4>
          <div class="label-row"><span>Phone</span><span><button class="phone-reveal-btn" data-a="614" data-b="850" data-c="13007">show</button></span></div>
          <div class="label-row"><span>Reply time</span><span>1 business day</span></div>
          <div class="label-row"><span>Hours</span><span>9am&ndash;11pm AEST</span></div>
          <div class="label-row"><span>Sales call?</span><span>Not required</span></div>
          <div class="label-row"><span>Data sold?</span><span>Never</span></div>
          <p class="muted" style="font-size:12px;margin:0 0 12px;">9am&ndash;11pm AEST (Sydney) covers UK mornings into early afternoon, and US West Coast afternoons into the small hours &mdash; the Cal.com link below shows live slots converted to your own timezone automatically.</p>
          <a class="btn btn-primary" href="https://cal.daintytrading.com/andrewdainty/telaloom" target="_blank" rel="noopener" data-umami-event="book_a_time_click" data-umami-event-source="contact_sidebar">Book a time directly &rarr;</a>
          <a class="btn btn-ghost" href="/services.html">See engagement types</a>
        </aside>
      </div>
    </div>
  </main>
</BaseLayout>
