---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Prospects — TelaLoom Admin">
  <style>
    .admin-wrap { max-width: 1000px; margin: 0 auto; padding: 40px 24px 80px; }
    .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
    .admin-nav { margin-bottom: 6px; }
    .admin-nav a { color: var(--text-dim); font-size: 13px; margin-right: 14px; }
    .admin-nav a.current { color: var(--text); font-weight: 600; }
    .run-picker { display: flex; align-items: center; gap: 10px; margin-bottom: 24px; }
    .run-picker label { font-size: 13px; color: var(--text-dim); }
    .run-picker select {
      padding: 8px 12px; border-radius: 10px; background: var(--bg-elev); border: 1px solid var(--border);
      color: var(--text); font: inherit;
    }
    .prospect-table { width: 100%; border-collapse: collapse; margin-bottom: 32px; }
    .prospect-table th, .prospect-table td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border); font-size: 13.5px; }
    .prospect-table th { color: var(--text-muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.03em; }
    .prospect-table tr { cursor: pointer; }
    .prospect-table tr:hover td { background: var(--bg-elev); }
    .prospect-table tr.selected td { background: var(--accent-soft); }
    .prospect-table .biz { font-weight: 600; color: var(--accent-text); }
    .prospect-table tr:hover .biz { text-decoration: underline; }
    .prospect-table .url { color: var(--text-muted); font-size: 12px; display: block; text-decoration: none; }
    .prospect-table .url:hover { text-decoration: underline; }
    .no-email-tag { color: #fbbf24; }
    .row-action-btn { font-size: 12.5px; padding: 5px 12px; }
    .status-pill {
      display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 600;
      background: var(--accent-soft); color: var(--accent-text); border: 1px solid var(--border-strong);
    }
    .status-pill.error { background: rgba(248,113,113,0.12); color: #f87171; border-color: rgba(248,113,113,0.3); }
    .sent-pill {
      display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 11.5px; font-weight: 600;
      background: rgba(74,222,128,0.12); color: #4ade80; border: 1px solid rgba(74,222,128,0.3);
    }
    .card { padding: 22px; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); margin-bottom: 32px; }
    .card label { display: block; font-size: 13px; color: var(--text-dim); margin-bottom: 6px; }
    .card input, .card textarea {
      width: 100%; padding: 10px 12px; border-radius: 10px; margin-bottom: 14px;
      background: var(--bg-elev); border: 1px solid var(--border); color: var(--text); font: inherit;
    }
    .card textarea { min-height: 220px; font-family: inherit; white-space: pre-wrap; }
    .draft-meta { font-size: 12.5px; color: var(--text-muted); margin-bottom: 14px; }
    .already-sent-note { font-size: 13px; color: #4ade80; margin-bottom: 14px; }
    .draft-status-banner {
      font-size: 13px; color: #fbbf24; background: rgba(251,191,36,0.1); border: 1px solid rgba(251,191,36,0.3);
      border-radius: 8px; padding: 10px 12px; margin-bottom: 14px;
    }
    .no-email-note {
      font-size: 13px; color: #fbbf24; background: rgba(251,191,36,0.1); border: 1px solid rgba(251,191,36,0.3);
      border-radius: 8px; padding: 10px 12px; margin-bottom: 14px;
    }
    .modal-backdrop {
      display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 1000;
      padding: 40px 20px; overflow-y: auto;
    }
    .modal-backdrop.open { display: flex; align-items: flex-start; justify-content: center; }
    .modal-card { position: relative; width: 100%; max-width: 640px; margin-bottom: 32px; }
    .modal-card.modal-card-sm { max-width: 440px; }
    .modal-close {
      position: absolute; top: 12px; right: 12px; background: none; border: none; color: var(--text-dim);
      font-size: 22px; line-height: 1; cursor: pointer; padding: 6px 10px; border-radius: 8px;
    }
    .modal-close:hover { background: var(--bg-elev); color: var(--text); }
    .outreach-panel { margin: 0 0 18px; padding: 14px 16px; }
    .outreach-stats { margin: 0; font-size: 13.5px; color: var(--text-dim); }
    .followup-item { display: flex; gap: 12px; align-items: center; justify-content: space-between; font-size: 13.5px; padding: 8px 0; border-top: 1px solid var(--border); }
    .followup-item:first-child { margin-top: 10px; }
    .followup-item .when { color: var(--text-muted); font-size: 12.5px; }
    .seq-note { display: block; font-size: 12px; color: var(--text-muted); margin-top: 4px; }
    .seq-pill { display: inline-block; font-size: 11.5px; font-weight: 600; border: 1px solid var(--border); border-radius: 999px; padding: 1px 8px; margin-left: 6px; color: var(--text-dim); }
    .seq-pill.replied { color: #4ade80; border-color: rgba(74,222,128,0.4); }
    .seq-pill.optout { color: #f87171; border-color: rgba(248,113,113,0.4); }
    .seq-actions { display: block; margin-top: 6px; }
    .seq-link { background: none; border: 0; padding: 0; margin-right: 10px; font: inherit; font-size: 12px; color: var(--text-muted); text-decoration: underline; cursor: pointer; }
    .seq-link:hover { color: var(--text); }
    .view-tabs { display: flex; gap: 8px; margin-bottom: 20px; border-bottom: 1px solid var(--border); }
    .view-tab {
      background: none; border: 0; border-bottom: 2px solid transparent; padding: 8px 4px; margin-right: 14px;
      font: inherit; font-size: 14px; color: var(--text-dim); cursor: pointer;
    }
    .view-tab.current { color: var(--text); font-weight: 600; border-bottom-color: var(--accent-text); }
    .queue-toolbar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: space-between; margin-bottom: 18px; }
    .queue-summary { margin: 0; font-size: 13.5px; color: var(--text-dim); }
    .queue-summary strong { color: var(--text); }
    .queue-cap-zero { color: #f87171; font-weight: 600; }
    .predraft-status { font-size: 12.5px; color: var(--text-muted); margin: -8px 0 18px; }
    .queue-card { margin-bottom: 18px; }
    .queue-card h3 { font-size: 15px; margin: 0 0 4px; }
    .queue-card h3 a { color: var(--text-muted); font-size: 12px; font-weight: 400; margin-left: 8px; }
    .queue-card .queue-actions { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .queue-card textarea { min-height: 260px; }
    .queue-card .queue-msg { font-size: 13px; margin: 10px 0 0; display: none; }
    .queue-card .queue-msg.error { color: #f87171; }
    .queue-card .queue-msg.ok { color: #4ade80; }
    .queue-card.done { opacity: 0.75; }
    .low-conf { color: #fbbf24; }
  </style>

  <div class="admin-wrap">
    <div class="admin-header">
      <div>
        <nav class="admin-nav"><a href="/admin/index.html">Clients</a><a href="/admin/projects.html">Projects</a><a href="/admin/prospects.html" class="current">Prospects</a></nav>
        <h1 style="font-size:22px;margin:0;">Prospects</h1>
      </div>
      <button class="btn btn-ghost" id="logout-btn">Log out</button>
    </div>

    <div class="card outreach-panel" id="outreach-panel" style="display:none;">
      <p class="outreach-stats" id="outreach-stats"></p>
      <div id="followups-list"></div>
    </div>

    <div class="view-tabs" role="tablist">
      <button type="button" class="view-tab current" id="tab-queue" data-view="queue" role="tab">Ready to send</button>
      <button type="button" class="view-tab" id="tab-runs" data-view="runs" role="tab">All prospects by run</button>
    </div>

    <!-- Every email that can go today, already written, across all runs. Send or Skip each. -->
    <section id="view-queue">
      <div class="queue-toolbar">
        <p class="queue-summary" id="queue-summary">Loading…</p>
        <button type="button" class="btn btn-ghost" id="predraft-btn" style="display:none;"></button>
      </div>
      <p class="predraft-status" id="predraft-status" style="display:none;"></p>
      <div id="queue-list"></div>
      <p id="queue-empty" class="muted" style="display:none;"></p>
    </section>

    <section id="view-runs" style="display:none;">
      <div class="run-picker">
        <label for="run-select">Batch run</label>
        <select id="run-select"></select>
      </div>
      <p id="no-runs" class="muted" style="display:none;">No prospect batch runs found under the mounted reports directory.</p>

      <table class="prospect-table" id="prospect-table" style="display:none;">
        <thead>
          <tr><th>Business / URL</th><th>Score</th><th>Findings</th><th>High sev.</th><th>Status</th><th>Action</th></tr>
        </thead>
        <tbody id="prospect-table-body"></tbody>
      </table>
      <p id="empty-state" class="muted" style="display:none;">No prospects in this run.</p>
    </section>

    <div class="modal-backdrop" id="error-backdrop">
      <div class="card modal-card modal-card-sm">
        <button type="button" class="modal-close" id="error-close" aria-label="Close">&times;</button>
        <p id="row-error-note" class="muted" style="margin:0;"></p>
      </div>
    </div>

    <div class="modal-backdrop" id="draft-backdrop">
      <div class="card modal-card" id="draft-card" role="dialog" aria-modal="true" aria-labelledby="draft-title">
        <button type="button" class="modal-close" id="draft-close" aria-label="Close">&times;</button>
        <h2 style="font-size:15px;margin:0 0 4px;" id="draft-title">Draft outreach email</h2>
        <p class="draft-meta" id="draft-meta"></p>
        <p class="already-sent-note" id="already-sent-note" style="display:none;"></p>
        <p class="no-email-note" id="no-email-note" style="display:none;"></p>
        <p class="draft-status-banner" id="draft-status-banner" style="display:none;"></p>
        <form id="send-form" novalidate>
          <label for="to">To</label>
          <input id="to" name="to" type="email" placeholder="owner@theirsite.com.au" required />
          <label for="subject">Subject</label>
          <input id="subject" name="subject" type="text" required />
          <label for="body">Body</label>
          <textarea id="body" name="body" required></textarea>
          <button type="submit" id="send-submit" class="btn btn-primary">Send</button>
          <button type="button" id="reload-draft-btn" class="btn btn-ghost">Regenerate draft</button>
          <p id="send-error" class="muted" style="font-size:13px;color:#f87171;display:none;margin-top:12px;"></p>
          <p id="send-success" class="muted" style="font-size:13px;color:#4ade80;display:none;margin-top:12px;"></p>
        </form>
      </div>
    </div>
  </div>

  <script is:inline src="/js/admin-common.js"></script>
  <script is:inline src="/js/admin-prospects.js?v=20261020"></script>
</AdminLayout>
