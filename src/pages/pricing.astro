---
import BaseLayout from '../layouts/BaseLayout.astro';
import Price from '../components/Price.astro';
import CurrencySwitch from '../components/CurrencySwitch.astro';
import { pricing } from '../data/pricing.ts';

// Every number and inclusion here is taken from the three service pages (website-builds,
// seo-geo-optimization, local-seo), which stay the detailed source. This page is the short version.
const n = (v: number) => v.toLocaleString('en-AU');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'TelaLoom pricing',
    url: 'https://telaloom.com/pricing.html',
    description: `Published prices for website builds and SEO & GEO work: fix days ${n(pricing.fixDay)} AUD, Setup ${n(pricing.setupSingleTemplate)} AUD, custom website build ${n(pricing.customBuild)} AUD, optional monthly plans from ${n(pricing.monitor)} AUD.`,
    isPartOf: { '@type': 'WebSite', name: 'TelaLoom', url: 'https://telaloom.com' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      { '@type': 'Question', name: 'How much does a website cost?', acceptedAnswer: { '@type': 'Answer', text: `A custom build is ${n(pricing.customBuild)} AUD, one-off. That covers design and copywriting, setup on hosting in your name (you pay the host directly), SSL, your domain (first year included) and Local SEO & GEO setup. Customer logins, bookings or payments are extra, estimated in days up front and priced from ${n(pricing.fixDay)} AUD per day.` } },
      { '@type': 'Question', name: 'How long does a website take?', acceptedAnswer: { '@type': 'Answer', text: "A first draft is live on a private preview link in weeks 1 to 2, with real pages and real copy, not a mockup. Agency estimates of around two months for a ten-page site are common. We skip the long proposal and the design-file stage and go straight to a working draft." } },
      { '@type': 'Question', name: 'What should I ask before hiring a web designer?', acceptedAnswer: { '@type': 'Answer', text: "Who owns the site and domain, where it is hosted and who pays, whether copy and SEO are included, how many rounds of changes you get, the payment terms, and whether there is a lock-in. We answer each of those on our website builds page." } },
      { '@type': 'Question', name: 'Is there a lock-in contract?', acceptedAnswer: { '@type': 'Answer', text: 'No. The one-off prices are one-off, and the monthly plans are month-to-month. Cancel anytime. You own the domain and the site.' } },
      { '@type': 'Question', name: 'What if my job is smaller than a Setup?', acceptedAnswer: { '@type': 'Answer', text: `Book fix days at ${n(pricing.fixDay)} AUD a day. We estimate the days up front and you approve before we start. Once a job passes about three days, Setup at ${n(pricing.setupSingleTemplate)} AUD is the better value.` } },
      { '@type': 'Question', name: 'Do I need a monthly plan?', acceptedAnswer: { '@type': 'Answer', text: "Often not. Setup is a one-time audit-and-fix, and the monthly plans are optional. If there's nothing useful to do in a given month, we tell you." } },
      { '@type': 'Question', name: 'What if my site goes down or gets hacked?', acceptedAnswer: { '@type': 'Answer', text: `Email hello@telaloom.com with URGENT in the subject. On the Care plan we reply the same business day (faster with Growth or Scale), and the cleanup is included when the cause is in what Care covers. Without a plan, hack cleanup is a flat ${n(pricing.incidentRecoveryNoPlan)} AUD for up to four hours of work.` } },
      { '@type': 'Question', name: 'What currency will I be invoiced in?', acceptedAnswer: { '@type': 'Answer', text: 'Australian clients are invoiced in AUD and international clients in USD. UK clients can be invoiced in GBP.' } },
    ],
  },
];
---
<BaseLayout
  currencySwitch
  title="Pricing — Website Builds, SEO & GEO | TelaLoom"
  description={`Published prices, no lock-in. Fix days ${n(pricing.fixDay)} AUD, SEO & GEO Setup ${n(pricing.setupSingleTemplate)} AUD, custom website build ${n(pricing.customBuild)} AUD, optional monthly plans from ${n(pricing.monitor)} AUD. Free website check first.`}
  canonicalPath="/pricing.html"
  jsonLd={jsonLd}
>
  <style>
    .price-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; margin:10px 0; }
    @media (max-width:760px) { .price-grid { grid-template-columns:1fr; } }
    .price-card { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:24px; display:flex; flex-direction:column; }
    .price-card .tier { font-size:13px; letter-spacing:.04em; text-transform:uppercase; color:var(--text-muted); }
    .price-card .price { font-size:30px; font-weight:700; margin:6px 0 2px; color:var(--text); }
    .price-card .price small { font-size:14px; font-weight:500; color:var(--text-muted); }
    .price-card .note { font-size:14px; color:var(--text-dim); margin:6px 0 16px; flex:1; }
    .price-card .more { font-size:14px; }
    .plan-list { margin:10px 0 0; border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; }
    .plan-row { display:grid; grid-template-columns:110px 150px 1fr; gap:16px; padding:14px 18px; border-top:1px solid var(--border); background:var(--bg-card); align-items:baseline; }
    .plan-row:first-child { border-top:none; }
    .plan-row .plan-name { font-weight:600; color:var(--text); }
    .plan-row .plan-price { color:var(--text); font-weight:500; white-space:nowrap; }
    .plan-row .plan-what { font-size:14px; color:var(--text-dim); }
    @media (max-width:760px) { .plan-row { grid-template-columns:1fr; gap:2px; } }
    .honest-note { background:var(--accent-soft); border:1px solid var(--border); border-radius:var(--radius-sm); padding:14px 16px; font-size:14px; color:var(--text-dim); margin:22px 0; }
    .honest-note strong { color:var(--text); }
  </style>

  <main id="main">
    <section class="detail-hero">
      <div class="container">
        <div class="crumbs"><a href="/">Home</a> &nbsp;/&nbsp; Pricing</div>
        <h1>Pricing</h1>
        <p class="lede">Four prices cover most of what we do. They&rsquo;re published, they&rsquo;re fixed, and none of them comes with a lock-in. If you don&rsquo;t know what you need yet, the <a href="/site-check.html">website check</a> is free.</p>
      </div>
    </section>

    <div class="container">
      <div class="detail-body">
        <article class="prose">
          <h2 style="margin-top:0;">The four prices</h2>
          <CurrencySwitch />
          <div class="price-grid">
            <div class="price-card">
              <span class="tier">Fix day</span>
              <div class="price"><Price item="fixDay" /> <small>per day</small></div>
              <p class="note">For small jobs on a site you already have. We estimate the days up front and you approve before we start. One-day minimum.</p>
              <a class="more" href="/services/seo-geo-optimization.html">What a fix day covers &rarr;</a>
            </div>

            <div class="price-card">
              <span class="tier">SEO &amp; GEO Setup</span>
              <div class="price"><Price item="setupSingleTemplate" /> <small>one-off</small></div>
              <p class="note">The audit, then we fix what it finds: schema, meta tags, sitemap, <code>llms.txt</code> and AI-crawler access. Roughly four days of work. <Price item="setupMultiTemplate" /> for e-commerce, multi-language, multi-template or multi-location sites.</p>
              <div class="more"><a href="/services/seo-geo-optimization.html">SEO &amp; GEO</a> <span style="color:var(--text-muted);">or</span> <a href="/services/local-seo.html">Local SEO &amp; GEO &rarr;</a></div>
            </div>

            <div class="price-card">
              <span class="tier">Website build</span>
              <div class="price"><Price item="customBuild" /> <small>one-off</small></div>
              <p class="note">A custom site, designed and written around your business. Setup on hosting in your name, SSL, your domain (first year included) and Local SEO &amp; GEO setup are in the price, not sold to you afterwards. You pay the host directly.</p>
              <a class="more" href="/services/website-builds.html">What&rsquo;s in a build &rarr;</a>
            </div>

            <div class="price-card">
              <span class="tier">Ongoing SEO &amp; GEO</span>
              <div class="price">from <Price item="monitor" /><small>/mo</small></div>
              <p class="note">Optional and month-to-month. Three levels, listed below. Plenty of sites only need the Setup, and we&rsquo;ll say so.</p>
              <a class="more" href="#monthly">See the monthly plans &darr;</a>
            </div>
          </div>

          <div class="honest-note">
            <strong>Not sure which one?</strong> Run the <a href="/site-check.html">free website check</a>. It takes about a minute and tells you whether you&rsquo;re looking at a fix day, a Setup or a rebuild &mdash; or nothing worth paying for.
          </div>

          <h2 id="monthly">Monthly plans</h2>
          <p>All optional, all cancel-anytime. Care keeps a site we built running. Monitor, Growth and Scale are about being found, and each one includes the one before it. Each plan has a published response time: Care 2 business days, Monitor and Growth 1 business day, Scale the same business day. <a href="/support.html">Support and response times &rarr;</a></p>
          <div class="plan-list">
            <div class="plan-row">
              <span class="plan-name">Care</span>
              <span class="plan-price"><Price item="carePlan" suffix="/mo" /></span>
              <span class="plan-what">Uptime and SSL monitoring, software and security updates on your own hosting, tested backups, a monthly security check, and up to 60 minutes a month of small changes. Hack and outage cleanup included when the cause is in what Care covers. No GST. Attached to every custom build by default; opt out if you&rsquo;d rather self-manage.</span>
            </div>
            <div class="plan-row">
              <span class="plan-name">Monitor</span>
              <span class="plan-price"><Price item="monitor" suffix="/mo" /></span>
              <span class="plan-what">Ranking and AI-citation monitoring, with a plain-English report each month. No fix pass included.</span>
            </div>
            <div class="plan-row">
              <span class="plan-name">Growth</span>
              <span class="plan-price"><Price item="growth" suffix="/mo" /></span>
              <span class="plan-what">Monitor, plus monthly work. For local businesses: Google Business Profile posts, review replies and a review campaign. For other sites: an optimization pass, and schema and <code>llms.txt</code> updates as content changes.</span>
            </div>
            <div class="plan-row">
              <span class="plan-name">Scale</span>
              <span class="plan-price"><Price item="scale" suffix="/mo" /></span>
              <span class="plan-what">Growth, plus new pages each month and a quarterly strategy call. For local businesses that also means full Google Business Profile management.</span>
            </div>
          </div>

          <h2>What isn&rsquo;t on this list</h2>
          <p><strong>Logins, bookings, payments.</strong> Anything with real application logic is estimated in days up front and priced from <Price item="fixDay" /> per day. You get the price in writing and approve it before we start.</p>
          <p><strong>AI work.</strong> Every AI engagement starts with a Discovery sprint at <Price item="aiDiscovery" symbol />: one week to map the workflow, build an eval set from your data and fix the scope and price. It's credited in full against the build. Builds are then quoted per engagement: <a href="/services/ai-automation-retrofit.html">automation retrofits</a> from <Price item="aiRetrofitFrom" symbol />, <a href="/services/ai-infrastructure.html">AI infrastructure</a> from <Price item="aiInfrastructureFrom" symbol />, and <a href="/services/ai-product-builds.html">AI product builds</a> from <Price item="aiProductBuildFrom" symbol />.</p>

          <h2>Frequently asked questions</h2>
          <details class="faq-item">
            <summary>How much does a website cost?</summary>
            <p>A custom build is <Price item="customBuild" />, one-off. That covers design and copywriting, setup on hosting in your name (you pay the host directly), SSL, your domain (first year included) and Local SEO &amp; GEO setup. Customer logins, bookings or payments are extra, estimated in days up front and priced from <Price item="fixDay" /> per day.</p>
          </details>
          <details class="faq-item">
            <summary>How long does a website take?</summary>
            <p>A first draft is live on a private preview link in weeks 1&ndash;2, with real pages and real copy, not a mockup. Agency estimates of around two months for a ten-page site are common. We skip the long proposal and the design-file stage and go straight to a working draft.</p>
          </details>
          <details class="faq-item">
            <summary>What should I ask before hiring a web designer?</summary>
            <p>Who owns the site and domain, where it&rsquo;s hosted and who pays, whether copy and SEO are included, how many rounds of changes you get, the payment terms, and whether there&rsquo;s a lock-in. <a href="/services/website-builds.html#questions-to-ask">Here are our answers</a>, so you can compare.</p>
          </details>
          <details class="faq-item">
            <summary>Is there a lock-in contract?</summary>
            <p>No. The one-off prices are one-off, and the monthly plans are month-to-month. Cancel anytime. You own the domain and the site.</p>
          </details>
          <details class="faq-item">
            <summary>What if my job is smaller than a Setup?</summary>
            <p>Book fix days at <Price item="fixDay" /> a day. We estimate the days up front and you approve before we start. Once a job passes about three days, Setup at <Price item="setupSingleTemplate" /> is the better value.</p>
          </details>
          <details class="faq-item">
            <summary>Do I need a monthly plan?</summary>
            <p>Often not. Setup is a one-time audit-and-fix, and the monthly plans are optional. If there&rsquo;s nothing useful to do in a given month, we tell you.</p>
          </details>
          <details class="faq-item">
            <summary>What if my site goes down or gets hacked?</summary>
            <p>Email hello@telaloom.com with URGENT in the subject. On the Care plan we reply the same business day (faster with Growth or Scale), and the cleanup is included when the cause is in what Care covers. Without a plan, hack cleanup is a flat <Price item="incidentRecoveryNoPlan" symbol /> for up to four hours of work. Details on the <a href="/support.html">support page</a>.</p>
          </details>
          <details class="faq-item">
            <summary>What currency will I be invoiced in?</summary>
            <p>Australian clients are invoiced in AUD and international clients in USD. UK clients can be invoiced in GBP.</p>
          </details>
        </article>

        <aside class="sidecard">
          <h4>At a glance</h4>
          <div class="label-row"><span>Website check</span><span>Free</span></div>
          <div class="label-row"><span>Fix day</span><span><Price item="fixDay" suffix="/day" /></span></div>
          <div class="label-row"><span>SEO &amp; GEO Setup</span><span><Price item="setupSingleTemplate" /></span></div>
          <div class="label-row"><span>Website build</span><span><Price item="customBuild" /></span></div>
          <div class="label-row"><span>Monthly plans</span><span><Price item="carePlan" to="scale" suffix="/mo" /></span></div>
          <div class="label-row"><span>Lock-in</span><span>None</span></div>
          <p style="font-size:12px;color:var(--text-muted);margin:10px 0 16px;">Tell us what you need and we&rsquo;ll say which of these it is before you pay for anything.</p>
          <a class="btn btn-primary" href="/contact.html" data-umami-event="cta_click" data-umami-event-target="get_a_quote" data-umami-event-source="pricing_sidecard">Get a quote &rarr;</a>
          <a class="btn btn-ghost" href="/site-check.html" data-umami-event="cta_click" data-umami-event-target="start_with_audit" data-umami-event-source="pricing_sidecard">Free website check</a>
        </aside>
      </div>

      <div class="cta-banner" style="margin-top:72px;">
        <h2>Not sure what it&rsquo;ll cost?</h2>
        <p>Send us your site, or your business name if you don&rsquo;t have one yet. We&rsquo;ll tell you which price applies, in writing, before anything starts.</p>
        <a class="btn btn-primary" href="/contact.html" data-umami-event="cta_click" data-umami-event-target="get_a_quote" data-umami-event-source="pricing_bottom_banner">Get a quote &rarr;</a>
      </div>
    </div>
  </main>
</BaseLayout>
