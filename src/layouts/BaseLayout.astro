---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string; // e.g. "/services.html" or "/" — appended to https://daintytrading.com
  ogImage?: string; // absolute URL, defaults to og-card.jpg
  robots?: string;
  jsonLd?: object[];
  hreflangAlternates?: boolean; // homepage + AU/UK/US pages only
  bodyClass?: string;
  lang?: string; // "en", "en-GB" for uk.html
  ogLocale?: string; // "en_AU", "en_GB", "en_US"
  chrome?: 'full' | 'none'; // 'none' skips <Header>/<Footer> for pages that build their own minimal shell (status.html)
}

const {
  title,
  description,
  canonicalPath,
  ogImage = 'https://daintytrading.com/og-card.jpg',
  robots = 'index, follow',
  jsonLd = [],
  hreflangAlternates = false,
  bodyClass,
  lang = 'en',
  ogLocale = 'en_AU',
  chrome = 'full',
} = Astro.props;

const canonicalUrl = `https://daintytrading.com${canonicalPath}`;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="google-site-verification" content="V4tv1Ds0qfskA15qPKqndEsVqsO7xyT10CYzFDBV0BQ" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta name="robots" content={robots} />
  <meta name="theme-color" content="#0a0c10" />

  {hreflangAlternates && (
    <>
      <link rel="alternate" hreflang="en" href="https://daintytrading.com/" />
      <link rel="alternate" hreflang="en-AU" href="https://daintytrading.com/australia.html" />
      <link rel="alternate" hreflang="en-GB" href="https://daintytrading.com/uk.html" />
      <link rel="alternate" hreflang="en-US" href="https://daintytrading.com/usa.html" />
      <link rel="alternate" hreflang="x-default" href="https://daintytrading.com/" />
    </>
  )}

  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta property="og:site_name" content="Dainty Trading" />
  <meta property="og:locale" content={ogLocale} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="apple-mobile-web-app-title" content="Dainty Trading" />
  <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

  {jsonLd.map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} />
  ))}

  {chrome === 'full' && (
    <>
      <script is:inline defer src="/stats/sc.js" data-website-id="8874c3d2-4193-4d58-8d4c-2fa4bcba5c1e"></script>
      <script is:inline defer src="/js/ui-handlers.js"></script>
    </>
  )}
</head>
<body class={bodyClass}>
  {chrome === 'full' && <Header />}
  <slot />
  {chrome === 'full' && <Footer />}
</body>
</html>
