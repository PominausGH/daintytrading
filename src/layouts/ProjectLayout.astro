---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
  slug: string;
}

const { entry, slug } = Astro.props;
const data = entry.data;
const { Content } = await entry.render();

const canonicalPath = `/projects/${slug}.html`;

const primarySchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': data.schemaType,
  name: data.name,
  description: data.description,
  ...(data.type === 'case-study' ? { url: `https://telaloom.com${canonicalPath}` } : {}),
  ...(data.schemaExtra ?? {}),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://telaloom.com/' },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: 'https://telaloom.com/work.html' },
    { '@type': 'ListItem', position: 3, name: data.name },
  ],
};
---
<BaseLayout
  title={data.title}
  description={data.description}
  canonicalPath={canonicalPath}
  ogImage={data.ogImage}
  robots={'unlisted' in data && data.unlisted ? 'noindex, follow' : undefined}
  jsonLd={[primarySchema, breadcrumbSchema]}
>
  <main id="main">
    <section class="detail-hero">
      <div class="container">
        <div class="crumbs"><a href="/">Home</a> / <a href="/work.html">Projects</a> / {data.name}</div>
        <h1>{data.name}</h1>
        <p class="lede">{data.lede}</p>
        <div class="meta-row">
          {data.metaChips.map((chip) => (
            <span class="chip"><strong>{chip.label}</strong>&nbsp; {chip.value}</span>
          ))}
        </div>
      </div>
    </section>

    {data.screenshot && (
      <div class="container" style="padding-top:0; padding-bottom:0;">
        <div style="max-width:900px; margin:0 auto 48px;">
          <div style="background:#1a1d26; border:1px solid var(--border); border-radius:14px; overflow:hidden;">
            <div style="background:#0f1117; padding:10px 16px; display:flex; align-items:center; gap:8px; border-bottom:1px solid var(--border);">
              <span style="width:11px;height:11px;border-radius:50%;background:#ff5f57;display:inline-block;"></span>
              <span style="width:11px;height:11px;border-radius:50%;background:#febc2e;display:inline-block;"></span>
              <span style="width:11px;height:11px;border-radius:50%;background:#28c840;display:inline-block;"></span>
              {data.screenshot.url && <span style="margin-left:8px;font-size:12px;color:var(--text-dim);">{data.screenshot.url}</span>}
            </div>
            {data.screenshot.url ? (
              <a href={data.screenshot.url} rel="noopener" target="_blank">
                <picture>
                  {data.screenshot.imageWebp && <source srcset={data.screenshot.imageWebp} type="image/webp" />}
                  <img src={data.screenshot.image} alt={data.screenshot.alt} width="1280" height="640" style="width:100%;display:block;" loading="lazy" decoding="async" />
                </picture>
              </a>
            ) : (
              <picture>
                {data.screenshot.imageWebp && <source srcset={data.screenshot.imageWebp} type="image/webp" />}
                <img src={data.screenshot.image} alt={data.screenshot.alt} width="1280" height="640" style="width:100%;display:block;" loading="lazy" decoding="async" />
              </picture>
            )}
          </div>
        </div>
      </div>
    )}

    <div class="container">
      <div class="detail-body">
        <article class="prose">
          <Content />
        </article>

        <aside class="sidecard">
          <h4>{data.sidecard.heading}</h4>
          {data.sidecard.rows.map((row) => (
            <div class="label-row"><span>{row.label}</span><span>{row.value}</span></div>
          ))}
          {data.sidecard.primaryCta && (
            <a class="btn btn-primary" href={data.sidecard.primaryCta.href} rel={data.sidecard.primaryCta.href.startsWith('http') ? 'noopener' : undefined}>{data.sidecard.primaryCta.label}</a>
          )}
          {data.sidecard.ghostCta && (
            <a class="btn btn-ghost" href={data.sidecard.ghostCta.href}>{data.sidecard.ghostCta.label}</a>
          )}
        </aside>
      </div>

      <div class="cta-banner" style="margin:48px 0 0;">
        <h2>{data.ctaBannerHeading}</h2>
        <p>{data.ctaBannerBody}</p>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
          <a class="btn btn-primary" href="/contact.html">Start a project &rarr;</a>
          <a class="btn btn-ghost" href="/services.html">See how we work</a>
        </div>
      </div>

      {(data.prevLink || data.nextLink) && (
        <nav class="next-prev" aria-label="Project navigation">
          {data.prevLink ? (
            <a href={data.prevLink.href}><div class="lbl">&larr; Previous</div><div class="ttl">{data.prevLink.label}</div></a>
          ) : <span />}
          {data.nextLink && (
            <a href={data.nextLink.href} style="text-align:right;"><div class="lbl">Next &rarr;</div><div class="ttl">{data.nextLink.label}</div></a>
          )}
        </nav>
      )}
    </div>
  </main>
</BaseLayout>
